{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/native-authorization.v1",
  "x-aidn-contract-version": "native-authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approved",
    "model_allowed",
    "configuration_sha256",
    "authorized_at_ms",
    "global_deadline_ms",
    "workflow_deadline_ms",
    "max_turn_ms",
    "max_responses",
    "max_bytes"
  ],
  "properties": {
    "approved": {
      "const": true
    },
    "model_allowed": {
      "const": true
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authorized_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "global_deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "workflow_deadline_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "max_turn_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2700000
    },
    "max_responses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "max_bytes": {
      "type": "integer",
      "minimum": 1048576,
      "maximum": 471859200
    }
  }
}
