{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-prework-witness.v1",
  "x-aidn-contract-version": "standard-cycle-prework-witness.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evaluation_operation_id",
    "evaluation_sha256",
    "subject_sha256",
    "report_sha256",
    "origin_operation_id",
    "proposal_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-prework-witness.v1"
    },
    "evaluation_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "origin_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
