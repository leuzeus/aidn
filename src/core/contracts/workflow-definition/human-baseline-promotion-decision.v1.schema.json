{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-baseline-promotion-decision.v1",
  "x-aidn-contract-version": "human-baseline-promotion-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "rationale",
    "promotion",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "human-baseline-promotion-decision.v1"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "promote",
        "not_requested",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "promotion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "summary"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}(?:-[A-Za-z0-9][A-Za-z0-9.-]{0,31})?$"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "choice": {
          "const": "promote"
        },
        "promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "summary"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}(?:-[A-Za-z0-9][A-Za-z0-9.-]{0,31})?$"
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400,
              "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
            }
          }
        }
      }
    },
    {
      "properties": {
        "choice": {
          "enum": [
            "not_requested",
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "promotion": {
          "type": "null"
        }
      }
    }
  ]
}
