{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-owner-observation.v1",
  "x-aidn-contract-version": "process-owner-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "instance_id",
    "instance_sha256",
    "inventory_sha256",
    "operation_id",
    "operation_record_sha256",
    "dispatch_sha256",
    "process_identity_sha256",
    "owner_status",
    "observed_at_ms",
    "business_effect",
    "process_tree_closure",
    "complete_resource_closure",
    "permits_effects",
    "written",
    "key_id",
    "authentication",
    "first_sample_started_at_ms",
    "last_sample_completed_at_ms"
  ],
  "properties": {
    "contract_version": {
      "const": "process-owner-observation.v1"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "operation_record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatch_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "process_identity_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner_status": {
      "enum": [
        "original_process_active",
        "original_process_absent",
        "unresolved"
      ]
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "business_effect": {
      "const": "unknown"
    },
    "process_tree_closure": {
      "const": "not_observed"
    },
    "complete_resource_closure": {
      "const": false
    },
    "permits_effects": {
      "const": false
    },
    "written": {
      "const": false
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authentication": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "first_sample_started_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_sample_completed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
