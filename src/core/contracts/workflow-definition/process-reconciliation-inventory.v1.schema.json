{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-reconciliation-inventory.v1",
  "x-aidn-contract-version": "process-reconciliation-inventory.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "instance_id", "instance_sha256", "instance_revision", "scope_id", "model_sha256", "policy_sha256", "model_source_sha256", "configuration_sha256", "physical_root_sha256", "authority_sha256", "context_sha256", "runtime_binding_sha256", "observed_at_ms", "resources", "operations", "accounting", "discovery", "complete_resource_closure", "permits_effects", "written", "key_id", "authentication"],
  "properties": {
    "contract_version": { "const": "process-reconciliation-inventory.v1" },
    "instance_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "instance_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "instance_revision": { "type": "integer", "minimum": 1 },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "policy_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_source_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "configuration_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "physical_root_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "context_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime_binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "observed_at_ms": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "resources": { "type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "kind", "sha256", "disposition", "details"],
      "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "kind": { "enum": ["artifact", "operation", "native_journal", "native_allocation", "human_capture", "control_capture", "local_effect_owner", "local_evidence"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "disposition": { "const": "unresolved" }, "details": { "type": "object" }
      }
    } },
    "operations": { "type": "array", "maxItems": 10000, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "record_sha256", "revision", "phase", "intent_sha256", "prefix_sha256", "binding_sha256", "grant_sha256", "owner", "effect_status", "results"],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^op_[a-f0-9]{40}$" },
        "record_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revision": { "type": "integer", "minimum": 1 },
        "phase": { "enum": ["staged", "dispatching", "receipted"] },
        "intent_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "prefix_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "binding_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "grant_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "owner": { "type": ["object", "null"], "additionalProperties": false, "required": ["generation", "pid"], "properties": {
          "generation": { "type": "string", "pattern": "^[a-f0-9-]{36}$" }, "pid": { "type": "integer", "minimum": 1 }
        } },
        "effect_status": { "enum": ["not_dispatched", "unknown", "no_effect", "confirmed"] },
        "results": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["receipt_id", "receipt_sha256", "output_sha256", "outcome", "effect_status"], "properties": {
            "receipt_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "outcome": { "enum": ["completed", "failed", "rejected", "blocked", "deferred", "cancelled", "reconciliation_required"] },
            "effect_status": { "enum": ["unknown", "no_effect", "confirmed"] }
          }
        } }
      }
    } },
    "accounting": { "type": "object", "additionalProperties": false,
      "required": ["native_known", "responses_observed_minimum", "storage_debit_bytes_minimum", "unresolved_native_allocations", "operation_attempts", "unknown_operations"],
      "properties": {
        "native_known": { "type": "boolean" },
        "responses_observed_minimum": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "storage_debit_bytes_minimum": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "unresolved_native_allocations": { "type": "integer", "minimum": 0, "maximum": 32 },
        "operation_attempts": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "unknown_operations": { "type": "integer", "minimum": 0, "maximum": 10000 }
      }
    },
    "discovery": { "type": "array", "minItems": 7, "maxItems": 7, "items": {
      "type": "object", "additionalProperties": false, "required": ["domain", "status"], "properties": {
        "domain": { "enum": ["deterministic", "native", "human", "control", "process", "git", "provider"] },
        "status": { "const": "independent_observation_required" }
      }
    } },
    "complete_resource_closure": { "const": false }, "permits_effects": { "const": false }, "written": { "const": false },
    "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "authentication": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
