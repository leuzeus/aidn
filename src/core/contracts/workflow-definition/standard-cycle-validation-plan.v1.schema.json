{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-validation-plan.v1",
  "x-aidn-contract-version": "standard-cycle-validation-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "work_sha256",
    "product_sha256",
    "profile_sha256",
    "descriptor_sha256",
    "proof_class",
    "files",
    "checks",
    "limits",
    "snapshot_path"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-validation-plan.v1"
    },
    "operation_ref": {
      "const": "cycle_validation_execute"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_operation_id"
      ],
      "properties": {
        "work_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "work_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "product_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "descriptor_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proof_class": {
      "enum": [
        "native",
        "fixture"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "present"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          },
          "present": {
            "type": "boolean"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_ref",
          "script",
          "snapshot_path",
          "args"
        ],
        "properties": {
          "test_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,95}$"
          },
          "script": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "snapshot_path": {
            "type": "string",
            "pattern": "^_aidn_checks/[A-Za-z0-9][A-Za-z0-9._-]{0,95}$"
          },
          "args": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_duration_ms",
        "max_output_bytes",
        "max_files",
        "max_snapshot_bytes"
      ],
      "properties": {
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "max_snapshot_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        }
      }
    },
    "snapshot_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
