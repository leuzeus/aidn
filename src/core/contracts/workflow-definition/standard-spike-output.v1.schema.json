{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-spike-output.v1",
  "x-aidn-contract-version": "standard-spike-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-spike-output.v1"
    },
    "operation_ref": {
      "enum": [
        "spike_conversion_admit",
        "spike_cycle_initialize",
        "spike_conversion_finalize",
        "spike_experiment_admit"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "no_effect",
        "confirmed",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mode_work_spike_requested": {
          "type": "boolean"
        },
        "spike_cycle_initialized": {
          "type": "boolean"
        },
        "spike_conversion_completed": {
          "type": "boolean"
        },
        "spike_experiments_pending": {
          "type": "boolean"
        },
        "mode_analysis_completed": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
