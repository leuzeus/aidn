{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/workflow-candidate.v1",
  "title": "workflow-candidate.v1",
  "x-aidn-contract-version": "workflow-candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority",
    "execution_available",
    "written",
    "workflow_id",
    "definition",
    "compilation",
    "explanation",
    "base",
    "diff",
    "permissions",
    "proposal_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "workflow-candidate.v1"
    },
    "authority": {
      "const": "proposal"
    },
    "execution_available": {
      "const": false
    },
    "written": {
      "const": false
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "definition": {
      "type": "object"
    },
    "compilation": {
      "type": "object"
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition_sha256",
        "compilation_sha256",
        "revision"
      ],
      "properties": {
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compilation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "transitions",
        "entry_changed"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "change",
              "before_sha256",
              "after_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,95}$"
              },
              "change": {
                "enum": [
                  "added",
                  "removed",
                  "changed"
                ]
              },
              "before_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "transitions": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "change",
              "before_sha256",
              "after_sha256"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,95}$"
              },
              "change": {
                "enum": [
                  "added",
                  "removed",
                  "changed"
                ]
              },
              "before_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "after_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "entry_changed": {
          "type": "boolean"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "within_ceiling",
        "reasons"
      ],
      "properties": {
        "within_ceiling": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "maxItems": 2048,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "id"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,95}$"
              }
            }
          }
        }
      }
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
