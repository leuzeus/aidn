{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-premerge-observe-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-premerge-observe-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_premerge_observe"
    },
    "outcome": {
      "enum": [
        "completed",
        "deferred",
        "blocked"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code",
            "merge_observation"
          ],
          "properties": {
            "reason_code": {
              "enum": [
                "STANDARD_PR_MERGE_REVIEW_EFFECTS_REQUIRED",
                "STANDARD_PR_MERGE_AWAITING_PROVIDER",
                "STANDARD_PR_MERGE_PROVIDER_REQUIRED"
              ]
            },
            "merge_observation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "triage_operation_id",
                "update_operation_id",
                "pre_merge_base_oid",
                "source_sha256",
                "provider"
              ],
              "properties": {
                "triage_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "update_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "pre_merge_base_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "provider": {
                  "type": "object"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "x-aidn-contract-version": "standard-pr-premerge-observe-output.v1"
}
