{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-handoff-operation-plan.v1",
  "x-aidn-contract-version": "standard-handoff-operation-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "occurrence_id",
    "instance_resource",
    "packet_plan_encoding",
    "packet_plan_sha256",
    "packet_plan_chunks"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-handoff-operation-plan.v1"
    },
    "operation_ref": {
      "const": "handoff_packet_publish"
    },
    "input": {
      "type": "object"
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "instance_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "kind",
        "sha256",
        "disposition",
        "details"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^artifact:workflows/process-instances/[a-z][a-z0-9_-]{0,95}\\.json$"
        },
        "kind": {
          "const": "artifact"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "disposition": {
          "const": "unresolved"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metadata_sha256",
            "source"
          ],
          "properties": {
            "metadata_sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-f0-9]{64}$"
            },
            "source": {
              "enum": [
                "files",
                "sqlite",
                "postgres"
              ]
            }
          }
        }
      }
    },
    "packet_plan_encoding": {
      "const": "json-utf8-v1"
    },
    "packet_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packet_plan_chunks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    }
  }
}
