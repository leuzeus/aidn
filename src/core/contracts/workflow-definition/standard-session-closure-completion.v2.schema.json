{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-closure-completion.v2",
  "x-aidn-contract-version": "standard-session-closure-completion.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "event_sha256",
    "session_close_completed",
    "completed_at",
    "decision_operation_id",
    "record_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-closure-completion.v2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,128}$"
    },
    "event_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_close_completed": {
      "const": true
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
