        },
        "outcome": {
          "const": "reconciliation_required"
        },
        "effect_status": {
          "const": "unknown"
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 15,
