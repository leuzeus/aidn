{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-entry-choice-checkpoint-output.v2",
  "x-aidn-contract-version": "standard-cycle-entry-choice-checkpoint-output.v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_ref",
        "outcome",
        "effect_status",
        "facts",
        "observations",
        "evidence_refs"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-cycle-entry-choice-checkpoint-output.v2"
        },
        "operation_ref": {
          "const": "cycle_entry_choice_checkpoint"
        },
        "outcome": {
          "const": "completed"
        },
        "effect_status": {
          "enum": [
            "confirmed",
            "no_effect"
          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_entry_choice_checkpoint_ready",
            "cycle_entry_choice_checkpoint_created",
            "cycle_entry_resume_allowed"
          ],
          "properties": {
            "cycle_entry_choice_checkpoint_ready": {
              "const": true
            },
            "cycle_entry_choice_checkpoint_created": {
              "type": "boolean"
            },
            "cycle_entry_resume_allowed": {
              "const": false
            }
          }
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "record_operation_id",
            "source_sha256",
            "session_id",
            "selected_cycle_id",
            "selected_state",
            "selected_branch",
            "selected_branch_head",
            "committed_paths",
            "git",
            "branch_activated",
            "implementation_authorized"
          ],
          "properties": {
            "record_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "session_id": {
              "type": "string",
              "pattern": "^S[0-9]{3,6}$"
            },
            "selected_cycle_id": {
              "type": "string",
              "pattern": "^C[0-9]{3,6}$"
            },
            "selected_state": {
              "enum": [
                "OPEN",
                "IMPLEMENTING",
                "VERIFYING"
              ]
            },
            "selected_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "selected_branch_head": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "committed_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^docs/audit/(?:(?:CURRENT-STATE|RUNTIME-STATE)[.]md|sessions/S[0-9]{3,6}[.]md|snapshots/context-snapshot[.]md|cycles/C[0-9]{3,6}-[A-Za-z0-9._-]+/status[.]md)$"
              },
              "maxItems": 131,
              "minItems": 0
            },
            "git": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "commit_sha",
                    "parent_sha",
                    "index_reconciled",
                    "working_tree_clean",
                    "lock_present",
                    "effect_status"
                  ],
                  "properties": {
                    "status": {
                      "const": "confirmed"
                    },
                    "commit_sha": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    "parent_sha": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    "index_reconciled": {
                      "const": true
                    },
                    "working_tree_clean": {
                      "const": true
                    },
                    "lock_present": {
                      "const": false
                    },
                    "effect_status": {
                      "const": "confirmed"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "head",
                    "effect_status"
                  ],
                  "properties": {
                    "status": {
                      "const": "no_change"
                    },
                    "head": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    "effect_status": {
                      "const": "no_effect"
                    }
                  }
                }
              ]
            },
            "branch_activated": {
              "const": false
            },
            "implementation_authorized": {
              "const": false
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
