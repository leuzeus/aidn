          "const": "no_effect"
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "maxItems": 15,
          "minItems": 0
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_ref",
        "outcome",
        "effect_status",
        "facts",
        "observations",
        "evidence_refs"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-cycle-entry-choice-checkpoint-output.v2"
