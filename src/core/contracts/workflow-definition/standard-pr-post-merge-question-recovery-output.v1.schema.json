{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-post-merge-question-recovery-output.v1",
  "x-aidn-contract-version": "standard-pr-post-merge-question-recovery-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-post-merge-question-recovery-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_post_merge_decision"
    },
    "outcome": {
      "enum": [
        "completed",
        "deferred"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "session_pr_post_merge_fast_forward": { "const": false } }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan",
        "grant"
      ],
      "properties": {
        "plan": {
          "type": "object"
        },
        "grant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authorized",
            "authority_id",
            "principal_sha256",
            "grant_sha256"
          ],
          "properties": {
            "authorized": {
              "const": true
            },
            "authority_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "principal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "grant_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^git:refs/aidn/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
