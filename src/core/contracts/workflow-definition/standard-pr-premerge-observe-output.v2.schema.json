{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-premerge-observe-output.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-premerge-observe-output.v2"
    },
    "operation_ref": {
      "const": "session_pr_premerge_observe"
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_pr_external_merge_observed"
      ],
      "properties": {
        "session_pr_external_merge_observed": {
          "const": false
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code"
      ],
      "properties": {
        "reason_code": {
          "const": "STANDARD_PR_PREMERGE_OPEN"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "x-aidn-contract-version": "standard-pr-premerge-observe-output.v2"
}
