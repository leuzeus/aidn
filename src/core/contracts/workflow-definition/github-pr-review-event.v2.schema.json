{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-pr-review-event.v2",
  "x-aidn-contract-version": "github-pr-review-event.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority_id",
    "source_event_id",
    "repository_id",
    "pull_request_id",
    "pull_request_number",
    "head_oid",
    "base_oid",
    "head_ref",
    "base_ref",
    "event_key",
    "revision",
    "occurred_at",
    "actor",
    "summary"
  ],
  "properties": {
    "contract_version": {
      "const": "github-pr-review-event.v2"
    },
    "authority_id": {
      "const": "github_review"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pull_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "pull_request_number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "head_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "head_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "event_key": {
      "const": "review_snapshot"
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "login",
        "type"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "login": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "type": {
          "const": "Bot"
        }
      }
    },
    "summary": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "body_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        },
        "body_chunks": {
          "items": {
            "type": "string",
            "maxLength": 65536
          },
          "maxItems": 1,
          "minItems": 1,
          "type": "array"
        },
        "node_id": {
          "minLength": 1,
          "maxLength": 256,
          "type": "string"
        },
        "kind": {
          "const": "codex-completed-no-findings"
        },
        "editor": {
          "additionalProperties": false,
          "required": [
            "node_id",
            "login",
            "type"
          ],
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "node_id": {
              "minLength": 1,
              "type": "string",
              "maxLength": 256
            },
            "type": {
              "const": "Bot"
            },
            "login": {
              "minLength": 1,
              "type": "string",
              "maxLength": 256
            }
          }
        },
        "last_edited_at": {
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object",
      "required": [
        "kind",
        "node_id",
        "created_at",
        "updated_at",
        "body_sha256",
        "body_chunks",
        "editor",
        "last_edited_at"
      ]
    }
  }
}
