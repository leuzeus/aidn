{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-spike-experiment-admission-output.v3",
  "x-aidn-contract-version": "standard-spike-experiment-admission-output.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "observations",
    "facts",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-spike-experiment-admission-output.v3"
    },
    "operation_ref": {
      "const": "spike_experiment_execution_admit"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "observations": {
      "type": "object",
      "additionalProperties": true
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spike_experiment_execution_admitted": {
          "const": true
        },
        "cycle_work_requested": {
          "const": true
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
