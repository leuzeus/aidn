{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-retained-verification-admission-output.v1",
  "x-aidn-contract-version": "standard-retained-verification-admission-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-retained-verification-admission-output.v1"
    },
    "operation_ref": {
      "const": "cycle_retained_verification_admit"
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_retained_verification_admitted"
      ],
      "properties": {
        "cycle_retained_verification_admitted": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof",
        "proof_sha256",
        "entry_operation_id",
        "implementation_authorized",
        "current_native_work_evidence",
        "current_validation_evidence"
      ],
      "properties": {
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "original_instance_id",
            "original_instance_sha256",
            "original_configuration_sha256",
            "native_journal_sha256",
            "audit_operation_id",
            "audit_journal_sha256",
            "verification_operation_id",
            "verification_journal_sha256",
            "evaluation_operation_id",
            "evaluation_journal_sha256",
            "validation_operation_id",
            "validation_journal_sha256",
            "context",
            "context_sha256",
            "audit_context_sha256",
            "product_sha256",
            "proposal_sha256",
            "contributors"
          ],
          "properties": {
            "original_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "original_instance_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "original_configuration_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "native_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "audit_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "audit_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "verification_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "verification_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evaluation_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "evaluation_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "validation_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "validation_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "context": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "session_id",
                "cycle_id",
                "cycle_path",
                "branch",
                "head",
                "mode",
                "cycle_state",
                "product_sha256"
              ],
              "properties": {
                "session_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "cycle_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "cycle_path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "head": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "mode": {
                  "const": "COMMITTING"
                },
                "cycle_state": {
                  "const": "VERIFYING"
                },
                "product_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "audit_context_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "product_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "proposal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contributors": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "agent_id",
                  "lineage_id"
                ],
                "properties": {
                  "agent_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "lineage_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        },
        "proof_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entry_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "implementation_authorized": {
          "const": false
        },
        "current_native_work_evidence": {
          "const": false
        },
        "current_validation_evidence": {
          "const": false
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
