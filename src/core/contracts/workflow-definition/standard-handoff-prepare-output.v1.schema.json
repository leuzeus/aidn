{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-handoff-prepare-output.v1",
  "x-aidn-contract-version": "standard-handoff-prepare-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "observations",
    "facts",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-handoff-prepare-output.v1"
    },
    "operation_ref": {
      "const": "handoff_prepare"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect",
        "unknown"
      ]
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "summary_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "git_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^S[0-9]{3,6}$"
        },
        "completed_stages": {
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "items": {
            "enum": [
              "hook",
              "hydration",
              "sync",
              "current",
              "runtime"
            ]
          }
        },
        "hook_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "hydrated_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sync_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "documents": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "metadata_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "maxLength": 192
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "metadata_sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "skipped_stages": {
          "type": "array",
          "minItems": 0,
          "maxItems": 3,
          "items": {
            "enum": [
              "hook",
              "hydration",
              "sync"
            ]
          }
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "handoff_preparation_completed": {
          "const": true
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
