{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-mode-work-preflight-input.v1",
  "x-aidn-contract-version": "standard-mode-work-preflight-input.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "mode"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "mode": {
      "enum": [
        "THINKING",
        "EXPLORING"
      ]
    }
  }
}
