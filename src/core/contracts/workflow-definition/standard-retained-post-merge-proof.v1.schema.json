{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-retained-post-merge-proof.v1",
  "x-aidn-contract-version": "standard-retained-post-merge-proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_instance_id",
    "original_instance_sha256",
    "original_configuration_sha256",
    "lineage_sha256",
    "provider_sha256",
    "session_id",
    "update_operation_id",
    "inherited_proof_sha256",
    "opening_operation_id",
    "disposition_operation_id",
    "fetch_operation_id",
    "opening_receipt_sha256",
    "decision_material_sha256",
    "fetch_receipt_sha256"
  ],
  "properties": {
    "original_instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "original_instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lineage_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provider_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "update_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "inherited_proof_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "opening_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "disposition_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "fetch_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "opening_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decision_material_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fetch_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
