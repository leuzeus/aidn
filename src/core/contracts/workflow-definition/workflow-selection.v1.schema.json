{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/workflow-selection.v1",
  "title": "workflow-selection.v1",
  "x-aidn-contract-version": "workflow-selection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "workflow_id",
    "revision",
    "scope",
    "seed",
    "activations",
    "selection_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "workflow-selection.v1"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256",
        "persistence_sha256",
        "runtime_scope_id",
        "activation"
      ],
      "properties": {
        "target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "persistence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_id",
            "revision"
          ],
          "properties": {
            "authority_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "instance_sha256",
        "definition",
        "compilation"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,95}$"
        },
        "instance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "definition": {
          "type": "object"
        },
        "compilation": {
          "type": "object"
        }
      }
    },
    "activations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal",
          "review"
        ],
        "properties": {
          "proposal": {
            "type": "object"
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "preview_sha256",
              "evidence"
            ],
            "properties": {
              "decision": {
                "const": "approve"
              },
              "preview_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "sha256"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "selection_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
