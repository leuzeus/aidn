{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-baseline-promotion-hook-plan.v1",
  "x-aidn-contract-version": "standard-baseline-promotion-hook-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input",
    "operation_id",
    "prepared_at_ms",
    "request",
    "record_plan_sha256",
    "record_output_sha256",
    "context_sha256",
    "boundary_sha256",
    "completion_cycle_id",
    "scope",
    "completion_preimages",
    "event_log"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-baseline-promotion-hook-plan.v1"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_operation_id"
      ],
      "properties": {
        "record_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "decision_operation_id",
        "closure_operation_id",
        "instance_id",
        "scope_id",
        "cycle_id",
        "cycle_path",
        "baseline_sha256",
        "history_sha256",
        "version",
        "summary",
        "evidence_refs",
        "product_sha256"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-baseline-promotion-request.v1"
        },
        "decision_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "closure_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^C[0-9]{3,6}$"
        },
        "cycle_path": {
          "type": "string",
          "pattern": "^cycles/C[0-9]{3,6}-[a-z]+-[A-Za-z0-9._-]+$"
        },
        "baseline_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}(?:-[A-Za-z0-9][A-Za-z0-9.-]{0,31})?$",
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "product_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "record_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completion_cycle_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^C[0-9]{3,6}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "state_mode"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "state_mode": {
          "enum": [
            "files",
            "dual",
            "db-only"
          ]
        }
      }
    },
    "completion_preimages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "metadata_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metadata_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "event_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
