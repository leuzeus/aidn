{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/workflow-instance.v1",
  "title": "workflow-instance.v1",
  "x-aidn-contract-version": "workflow-instance.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "instance_id",
    "revision",
    "definition",
    "compilation",
    "scope",
    "events",
    "instance_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "workflow-instance.v1"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 257
    },
    "definition": {
      "type": "object"
    },
    "compilation": {
      "type": "object"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_sha256",
        "runtime_scope_id",
        "persistence_sha256",
        "activation"
      ],
      "properties": {
        "persistence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_id",
            "revision"
          ],
          "properties": {
            "authority_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "step_id",
              "outcome",
              "evidence"
            ],
            "properties": {
              "kind": {
                "const": "human"
              },
              "step_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,95}$"
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "maxLength": 96
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "sha256"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1024
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "step_id",
              "run_id",
              "plan_sha256",
              "configuration_sha256",
              "binding_sha256",
              "configuration_path",
              "plan_path"
            ],
            "properties": {
              "kind": {
                "const": "segment_intent"
              },
              "step_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,95}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "plan_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "configuration_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "binding_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "configuration_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "plan_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "step_id",
              "run_id",
              "outcome",
              "status",
              "status_sha256"
            ],
            "properties": {
              "kind": {
                "const": "segment_result"
              },
              "step_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,95}$"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "outcome": {
                "enum": [
                  "completed",
                  "failed"
                ]
              },
              "status": {
                "type": "object"
              },
              "status_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        ]
      }
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
