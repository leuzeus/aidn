{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-cycle-entry-choice.v1",
  "x-aidn-contract-version": "human-cycle-entry-choice.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "selection",
    "rationale",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "human-cycle-entry-choice.v1"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "select_cycle",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "selection": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_id",
            "carryover_decisions"
          ],
          "properties": {
            "cycle_id": {
              "type": "string",
              "pattern": "^C[0-9]{3,6}$"
            },
            "carryover_decisions": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "cycle_id",
                  "action",
                  "outcome",
                  "rationale"
                ],
                "properties": {
                  "cycle_id": {
                    "type": "string",
                    "pattern": "^C[0-9]{3,6}$"
                  },
                  "action": {
                    "enum": [
                      "integrate_now",
                      "import_now",
                      "defer",
                      "drop"
                    ]
                  },
                  "outcome": {
                    "enum": [
                      null,
                      "NO_GO",
                      "DROPPED"
                    ]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
