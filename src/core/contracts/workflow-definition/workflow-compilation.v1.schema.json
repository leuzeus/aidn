{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/workflow-compilation.v1",
  "title": "Internal shadow workflow-compilation.v1",
  "x-aidn-contract-version": "workflow-compilation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "compiler_version",
    "authority",
    "execution_available",
    "written",
    "definition",
    "registry",
    "context",
    "context_sha256",
    "binding",
    "parameters",
    "parameters_sha256",
    "entry",
    "steps",
    "transitions",
    "effects",
    "artifacts",
    "diagnostics",
    "compilation_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "workflow-compilation.v1"
    },
    "compiler_version": {
      "const": "workflow-shadow-compiler.v1"
    },
    "authority": {
      "const": "shadow"
    },
    "execution_available": {
      "const": false
    },
    "written": {
      "const": false
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 96
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "workflow-shadow-registry.v1"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "authority",
        "product_version",
        "workflow_version",
        "state_mode"
      ],
      "properties": {
        "contract_version": {
          "const": "workflow-shadow-context.v1"
        },
        "authority": {
          "const": "caller_supplied"
        },
        "product_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "workflow_version": {
          "const": 7
        },
        "state_mode": {
          "enum": [
            "files",
            "dual",
            "db-only"
          ]
        }
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "null"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "parameters_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 96
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "outcomes",
          "rule_refs",
          "evidence_refs",
          "primitive_ref",
          "primitive_version",
          "admission_boundary",
          "observation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 96
          },
          "kind": {
            "enum": [
              "aidn_step",
              "agent_segment",
              "gate",
              "human_decision",
              "terminal"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "anchor"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(docs|src|tools|scaffold|package)/[A-Za-z0-9_./-]+$"
              },
              "anchor": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              }
            }
          },
          "outcomes": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 96
            }
          },
          "rule_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^SPEC-R(0[1-9]|1[01])$"
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 96
            }
          },
          "terminal_result": {
            "enum": [
              "completed",
              "stopped",
              "deferred"
            ]
          },
          "primitive_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "maxLength": 96
          },
          "primitive_version": {
            "type": "integer",
            "minimum": 1
          },
          "admission_boundary": {
            "type": "boolean"
          },
          "observation": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "values"
                ],
                "properties": {
                  "field": {
                    "const": "action"
                  },
                  "values": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "outcome",
          "to",
          "rule_refs",
          "evidence_refs",
          "condition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 96
          },
          "from": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 96
          },
          "outcome": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 96
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 96
          },
          "rule_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^SPEC-R(0[1-9]|1[01])$"
            }
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$",
              "maxLength": 96
            }
          },
          "max_traversals": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "on_exhausted": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$",
            "maxLength": 96
          },
          "condition": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "operator",
              "value"
            ],
            "properties": {
              "field": {
                "const": "outcome"
              },
              "operator": {
                "const": "equals"
              },
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              }
            }
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "maxItems": 0
    },
    "artifacts": {
      "type": "array",
      "maxItems": 0
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "path"
        ],
        "properties": {
          "code": {
            "enum": [
              "SHADOW_ONLY",
              "SEGMENT_PLAN_AND_ADMISSION_REQUIRED",
              "HANDLER_ADMISSION_REQUIRED"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "compilation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
