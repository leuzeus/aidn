{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-operation-disposition-plan.v3",
  "x-aidn-contract-version": "process-operation-disposition-plan.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "instance_id",
    "instance_sha256",
    "instance_revision",
    "scope_id",
    "model_sha256",
    "authority_sha256",
    "runtime_sha256",
    "physical_root_sha256",
    "journal_sha256",
    "dispatch_sha256",
    "inventory_sha256",
    "fence_sha256",
    "assessment",
    "output_sha256",
    "prepared_at_ms",
    "nonce",
    "key_id",
    "authentication",
    "continuation"
  ],
  "properties": {
    "contract_version": {
      "const": "process-operation-disposition-plan.v3"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instance_revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtime_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "physical_root_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "fence_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "assessment": {
      "const": "known_partial_handoff_publication"
    },
    "output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authentication": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "original_receipt_sha256",
        "packet_plan_sha256",
        "source_sha256",
        "boundary_sha256",
        "state_sha256",
        "owned_paths",
        "expected_output_sha256",
        "expected_output",
        "lock_sha256"
      ],
      "properties": {
        "profile": {
          "const": "standard-handoff-publication-known-partial.v1"
        },
        "original_receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "boundary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "owned_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "HANDOFF-PACKET.md"
          }
        },
        "expected_output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_output": {
          "type": "object"
        },
        "packet_plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
