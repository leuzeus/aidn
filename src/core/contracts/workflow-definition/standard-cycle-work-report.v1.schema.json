{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-work-report.v1",
  "x-aidn-contract-version": "standard-cycle-work-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "context_sha256",
    "task",
    "changes",
    "notes"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-work-report.v1"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "operation"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          },
          "operation": {
            "enum": [
              "update",
              "add",
              "delete"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  }
}
