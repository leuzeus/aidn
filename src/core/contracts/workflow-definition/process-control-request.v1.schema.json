{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-control-request.v1",
  "x-aidn-contract-version": "process-control-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scope_id",
    "instance_id",
    "instance_sha256",
    "model_sha256",
    "instance_revision",
    "occurrence_id",
    "correlation_id",
    "event_keys",
    "context_sha256",
    "branch",
    "head"
  ],
  "properties": {
    "contract_version": {
      "const": "process-control-request.v1"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "instance_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 512
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "event_keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "head": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    }
  }
}
