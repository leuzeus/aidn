{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-output.v1",
  "x-aidn-contract-version": "standard-cycle-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-output.v1"
    },
    "operation_ref": {
      "enum": [
        "cycle_context_refresh",
        "cycle_admit",
        "cycle_initialize",
        "branch_cycle_audit"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "deferred",
        "rejected",
        "cancelled",
        "failed",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "no_effect",
        "confirmed",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cycle_creation_allowed": {
          "type": "boolean"
        },
        "cycle_initialized": {
          "type": "boolean"
        },
        "branch_cycle_mapped": {
          "type": "boolean"
        },
        "cycle_dor_ready": {
          "type": "boolean"
        },
        "cycle_context_refreshed": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": true
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
