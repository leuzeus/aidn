{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-spike-question.v1",
  "x-aidn-contract-version": "standard-spike-question.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "instance_id",
    "scope_id",
    "occurrence_id",
    "intent_sha256",
    "session_id",
    "choices",
    "review_operation_id",
    "review"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-spike-question.v1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "intent_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": [
          "convert-to-spike",
          "refused",
          "deferred",
          "cancelled"
        ]
      }
    },
    "review_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "analysis",
        "inventory_sha256",
        "minimum_cycle_number",
        "continuity_sha256",
        "session_sha256",
        "current_sha256"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-spike-review.v1"
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "session_id",
            "mode",
            "context_sha256",
            "product_sha256",
            "head",
            "branch",
            "report",
            "report_sha256",
            "producer",
            "reference"
          ],
          "properties": {
            "contract_version": {
              "const": "standard-mode-work-review.v1"
            },
            "session_id": {
              "type": "string",
              "pattern": "^S[0-9]{3,6}$"
            },
            "mode": {
              "enum": [
                "THINKING",
                "EXPLORING"
              ]
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "product_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_version",
                "context_sha256",
                "mode",
                "objective",
                "disposition",
                "findings",
                "rationale",
                "evidence_refs"
              ],
              "properties": {
                "contract_version": {
                  "const": "standard-mode-work-report.v1"
                },
                "context_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mode": {
                  "enum": [
                    "THINKING",
                    "EXPLORING"
                  ]
                },
                "objective": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "disposition": {
                  "enum": [
                    "thinking_complete",
                    "nonretained",
                    "retain_requested",
                    "waiting"
                  ]
                },
                "findings": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ref",
                      "sha256"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            },
            "report_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "producer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instance_id",
                "model_sha256",
                "occurrence_id",
                "result_id"
              ],
              "properties": {
                "instance_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "model_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "occurrence_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "result_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "minimum_cycle_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "continuity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
