{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-post-merge-fetch-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation_ref", "outcome", "effect_status", "facts", "observations", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-pr-post-merge-fetch-output.v1" },
    "operation_ref": { "const": "session_pr_post_merge_fetch" },
    "outcome": { "enum": ["completed", "blocked", "reconciliation_required"] },
    "effect_status": { "enum": ["confirmed", "no_effect", "unknown"] },
    "facts": { "type": "object", "maxProperties": 0 },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason_code"],
          "properties": { "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["fetch"],
          "properties": {
            "fetch": {
              "type": "object",
              "additionalProperties": false,
              "required": ["merge_operation_id", "merge_receipt_sha256", "confirmation", "source_ref", "local_head",
                "fetched_head", "merge_oid", "proof_ref", "ahead", "behind", "plan_sha256"],
              "properties": {
                "merge_operation_id": { "type": "string", "pattern": "^op_[a-f0-9]{40}$" },
                "merge_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "confirmation": { "enum": ["executed", "observed"] },
                "source_ref": { "type": "string", "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$" },
                "local_head": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
                "fetched_head": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
                "merge_oid": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
                "proof_ref": { "type": "string", "pattern": "^refs/aidn/post-merge/[a-f0-9]{32}$" },
                "ahead": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "behind": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
              }
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "sha256"],
        "properties": {
          "ref": { "type": "string", "pattern": "^git:refs/aidn/post-merge/[a-f0-9]{32}$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
