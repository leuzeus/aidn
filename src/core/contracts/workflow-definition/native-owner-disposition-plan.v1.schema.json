{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/native-owner-disposition-plan.v1",
  "x-aidn-contract-version": "native-owner-disposition-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dispatch_id",
    "journal_id",
    "generation",
    "instance_id",
    "instance_sha256",
    "scope_id",
    "model_sha256",
    "configuration_sha256",
    "physical_root_sha256",
    "subject_sha256",
    "lock_sha256",
    "original_lease_sha256",
    "original_fence_sha256",
    "prepared_at_ms",
    "nonce",
    "key_id",
    "authentication",
    "dispatch_sha256",
    "journal_sha256",
    "allocation_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "native-owner-disposition-plan.v1"
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^native_dispatch_[a-f0-9]{40}$"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^native_[a-f0-9]{40}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "physical_root_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lock_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_lease_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_fence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authentication": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allocation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
