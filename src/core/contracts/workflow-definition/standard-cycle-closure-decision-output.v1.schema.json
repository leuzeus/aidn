{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-closure-decision-output.v1",
  "x-aidn-contract-version": "standard-cycle-closure-decision-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-closure-decision-output.v1"
    },
    "operation_ref": {
      "const": "cycle_closure_decision"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cycle_closure_choice_recorded": {
          "type": "boolean"
        },
        "cycle_retention_requested": {
          "type": "boolean"
        },
        "cycle_no_go_requested": {
          "type": "boolean"
        },
        "cycle_drop_requested": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_sha256",
        "review_sha256",
        "source_sha256",
        "lifecycle_transition",
        "skill_completion",
        "risk_acceptances",
        "inbox_id",
        "source_ref",
        "choice"
      ],
      "properties": {
        "question_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "lifecycle_transition": {
          "const": "none"
        },
        "skill_completion": {
          "const": "pending"
        },
        "risk_acceptances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding_id",
              "rationale"
            ],
            "properties": {
              "finding_id": {
                "type": "string",
                "minLength": 11,
                "maxLength": 32,
                "pattern": "^FINDING-[0-9]{3,6}$"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              }
            }
          },
          "minItems": 0,
          "maxItems": 64
        },
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "choice": {
          "enum": [
            "retain",
            "no_go",
            "drop",
            "refused",
            "deferred",
            "cancelled"
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
