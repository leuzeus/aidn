{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-pr-review-receive-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-pr-review-receive-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_review_receive"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_pr_review_event_received": {
          "const": true
        },
        "session_pr_triage_required": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "completed"
        },
        "facts": {
          "required": [
            "session_pr_review_event_received",
            "session_pr_triage_required"
          ]
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "inbox_id",
            "source_sha256",
            "delivery_sha256",
            "payload",
            "acceptance",
            "merge_authorization"
          ],
          "properties": {
            "inbox_id": {
              "type": "string",
              "pattern": "^control_[a-f0-9]{40}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "delivery_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "payload": {
              "x-aidn-contract-version": "process-pr-review-payload.v1",
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_version",
                "event",
                "observation"
              ],
              "properties": {
                "contract_version": {
                  "const": "process-pr-review-payload.v1"
                },
                "event": {
                  "type": "object"
                },
                "observation": {
                  "type": "object"
                }
              }
            },
            "acceptance": {
              "const": "pending-triage-and-policy-evaluation"
            },
            "merge_authorization": {
              "const": "not-established"
            }
          }
        },
        "evidence_refs": {
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "blocked"
        },
        "facts": {
          "maxProperties": 0
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    }
  ]
}
