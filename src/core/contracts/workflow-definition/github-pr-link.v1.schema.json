{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-pr-link.v1",
  "x-aidn-contract-version": "github-pr-link.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repository_id",
    "node_id",
    "number",
    "head_branch",
    "base_branch",
    "head_oid",
    "base_oid",
    "state",
    "draft",
    "url",
    "title_sha256",
    "body_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "github-pr-link.v1"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "head_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "head_oid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_oid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "state": {
      "enum": [
        "OPEN",
        "CLOSED",
        "MERGED"
      ]
    },
    "draft": {
      "type": "boolean"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^https://github[.]com/"
    },
    "title_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "body_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
