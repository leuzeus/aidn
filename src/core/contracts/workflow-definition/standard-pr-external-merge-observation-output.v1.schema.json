{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-external-merge-observation-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-external-merge-observation-output.v1"
    },
    "operation_ref": {
      "enum": [
        "session_pr_premerge_observe",
        "session_pr_checks_accept"
      ]
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_pr_external_merge_observed"
      ],
      "properties": {
        "session_pr_external_merge_observed": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "merge_observation"
      ],
      "properties": {
        "reason_code": {
          "const": "STANDARD_PR_EXTERNAL_MERGE_R08_INCIDENT"
        },
        "merge_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "triage_operation_id",
            "update_operation_id",
            "pre_merge_base_oid",
            "source_sha256",
            "provider"
          ],
          "properties": {
            "triage_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "update_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "pre_merge_base_oid": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "source_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "provider": {
              "type": "object"
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1
    }
  },
  "x-aidn-contract-version": "standard-pr-external-merge-observation-output.v1"
}
