{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-mode-work-decision-output.v2",
  "x-aidn-contract-version": "standard-mode-work-decision-output.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-mode-work-decision-output.v2"
    },
    "operation_ref": {
      "const": "mode_work_continue_decision"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode_work_continue_requested": {
          "type": "boolean"
        },
        "mode_analysis_completed": {
          "const": false
        },
        "mode_work_handoff_requested": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_sha256",
        "review_sha256",
        "source_sha256",
        "choice",
        "product_effects_authorized",
        "retention_authorized",
        "native_authority_renewed",
        "inbox_id",
        "source_ref",
        "current_context_sha256",
        "handoff"
      ],
      "properties": {
        "question_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choice": {
          "enum": [
            "continue_analysis",
            "handoff",
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "product_effects_authorized": {
          "const": false
        },
        "retention_authorized": {
          "const": false
        },
        "native_authority_renewed": {
          "const": false
        },
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "current_context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "handoff": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_version",
                "next_agent_role",
                "next_agent_action",
                "next_agent_goal",
                "handoff_note",
                "from_agent_role",
                "from_agent_action"
              ],
              "properties": {
                "contract_version": {
                  "const": "standard-handoff-publication-input.v1"
                },
                "next_agent_role": {
                  "enum": [
                    "coordinator",
                    "executor",
                    "auditor",
                    "repair"
                  ]
                },
                "next_agent_action": {
                  "enum": [
                    "reanchor",
                    "implement",
                    "audit",
                    "analyze",
                    "repair",
                    "relay",
                    "close",
                    "coordinate"
                  ]
                },
                "next_agent_goal": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 8192,
                  "pattern": "^[^\\r\\n]+$"
                },
                "handoff_note": {
                  "type": "string",
                  "maxLength": 4096,
                  "pattern": "^[^\\r\\n]*$"
                },
                "from_agent_role": {
                  "enum": [
                    "coordinator",
                    "executor",
                    "auditor",
                    "repair"
                  ]
                },
                "from_agent_action": {
                  "enum": [
                    "reanchor",
                    "implement",
                    "audit",
                    "analyze",
                    "repair",
                    "relay",
                    "close",
                    "coordinate"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
