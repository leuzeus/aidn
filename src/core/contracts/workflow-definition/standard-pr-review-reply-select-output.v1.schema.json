{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-review-reply-select-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-review-reply-select-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_review_reply_select"
    },
    "outcome": {
      "enum": [
        "completed",
        "deferred",
        "blocked"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_pr_replies_observed"
          ],
          "properties": {
            "session_pr_replies_observed": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selection"
          ],
          "properties": {
            "selection": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source_sha256",
                    "thread_id",
                    "target_comment_id",
                    "basis_sha256"
                  ],
                  "properties": {
                    "source_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "thread_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                    },
                    "target_comment_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                    },
                    "basis_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 0
    }
  }
}
