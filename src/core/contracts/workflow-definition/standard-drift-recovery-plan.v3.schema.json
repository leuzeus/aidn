{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "standard-drift-recovery-plan.v3"
    },
    "review_kind": {
      "const": "objective_signal_disagreement"
    },
    "review_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "evaluation_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^C[0-9]{3,6}$"
    },
    "session_objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "cycle_objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "context_sha256",
        "original_objective",
        "current_objective",
        "drift_level",
        "objective_changed",
        "changes",
        "keep",
        "discard",
        "split_recommendation",
        "recommendation",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-drift-report.v1"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "current_objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "drift_level": {
          "enum": [
            "none",
            "mild",
            "severe"
          ]
        },
        "objective_changed": {
          "type": "boolean"
        },
        "changes": {
          "title": "Diagnosed deviations from the stated objective or baseline; planned product edits remain separate context evidence",
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "keep": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "discard": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "split_recommendation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_cycle",
            "new_branch",
            "change_request_required",
            "impact"
          ],
          "properties": {
            "new_cycle": {
              "type": "boolean"
            },
            "new_branch": {
              "type": "boolean"
            },
            "change_request_required": {
              "type": "boolean"
            },
            "impact": {
              "enum": [
                "none",
                "low",
                "medium",
                "high"
              ]
            }
          }
        },
        "recommendation": {
          "enum": [
            "continue",
            "requirements_delta",
            "new_cycle",
            "rollback",
            "human_arbitration"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "gate_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level1",
        "level3",
        "other_signals"
      ],
      "properties": {
        "level1": {
          "type": "object"
        },
        "level3": {
          "type": "object"
        },
        "other_signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "const": "objective_delta"
          }
        }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "enum": [
          "confirm_alignment",
          "request_diagnosis"
        ]
      }
    },
    "previous_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "receipt_sha256",
        "plan_sha256",
        "output_sha256",
        "alignment_sha256",
        "report_sha256",
        "event_sha256",
        "event_offset"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "alignment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "required": [
    "contract_version",
    "review_kind",
    "review_operation_id",
    "evaluation_operation_id",
    "evaluation_sha256",
    "context_sha256",
    "prepared_at_ms",
    "session_id",
    "cycle_id",
    "session_objective",
    "cycle_objective",
    "report",
    "gate_constraints",
    "choices",
    "previous_completion"
  ],
  "$id": "aidn://contracts/workflow-definition/standard-drift-recovery-plan.v3",
  "x-aidn-contract-version": "standard-drift-recovery-plan.v3"
}
