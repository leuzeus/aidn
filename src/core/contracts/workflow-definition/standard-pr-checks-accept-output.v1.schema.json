{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-checks-accept-output.v1",
  "x-aidn-contract-version": "standard-pr-checks-accept-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-checks-accept-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_checks_accept"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "deferred"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "session_pr_required_checks_accepted": {
          "const": true
        }
      }
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subject",
            "observed_at_ms"
          ],
          "properties": {
            "subject": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "triage_operation_id",
                "update_operation_id",
                "source_sha256",
                "repository_id",
                "pull_request_id",
                "pull_request_number",
                "head_oid",
                "base_oid",
                "head_ref",
                "base_ref",
                "actor_id",
                "resolution_operation_id",
                "resolution_receipt_sha256",
                "resolution_expires_at_ms",
                "policy_sha256",
                "checks"
              ],
              "properties": {
                "triage_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "update_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "repository_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                },
                "pull_request_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                },
                "pull_request_number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                "head_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "base_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "head_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "base_ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "actor_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                },
                "resolution_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "resolution_receipt_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "resolution_expires_at_ms": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "policy_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "checks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "kind",
                      "producer_id",
                      "result_id",
                      "result_sha256"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[^\\u0000-\\u001f\\u007f]{1,100}$"
                      },
                      "kind": {
                        "enum": [
                          "check_run",
                          "commit_status"
                        ]
                      },
                      "producer_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                      },
                      "result_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_=-]{1,256}$"
                      },
                      "result_sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            },
            "observed_at_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 0
    }
  }
}
