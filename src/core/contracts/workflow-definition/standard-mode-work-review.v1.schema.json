{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-mode-work-review.v1",
  "x-aidn-contract-version": "standard-mode-work-review.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "session_id",
    "mode",
    "context_sha256",
    "product_sha256",
    "head",
    "branch",
    "report",
    "report_sha256",
    "producer",
    "reference"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-mode-work-review.v1"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "mode": {
      "enum": [
        "THINKING",
        "EXPLORING"
      ]
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "product_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "context_sha256",
        "mode",
        "objective",
        "disposition",
        "findings",
        "rationale",
        "evidence_refs"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-mode-work-report.v1"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mode": {
          "enum": [
            "THINKING",
            "EXPLORING"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "disposition": {
          "enum": [
            "thinking_complete",
            "nonretained",
            "retain_requested",
            "waiting"
          ]
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "model_sha256",
        "occurrence_id",
        "result_id"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "occurrence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "result_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
