{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-handoff-resource-request.v1",
  "x-aidn-contract-version": "standard-handoff-resource-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "instance_id",
    "instance_sha256",
    "scope_id",
    "model_sha256",
    "configuration_sha256",
    "physical_root_sha256",
    "inventory_material_sha256",
    "native_history_sha256",
    "ownership_sha256",
    "issued_at_ms",
    "key_id",
    "authentication"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-handoff-resource-request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "physical_root_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_material_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_history_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ownership_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "issued_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "key_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authentication": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
