{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-plan-proposal.v1",
  "x-aidn-contract-version": "standard-cycle-plan-proposal.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "context_sha256",
    "session_id",
    "cycle_id",
    "cycle_type",
    "objective",
    "scope",
    "non_scope",
    "constraints",
    "risks",
    "surface",
    "usage_matrix",
    "requirements",
    "tests",
    "tasks",
    "architecture_notes",
    "impact_notes",
    "rollback_strategy",
    "compatibility_strategy",
    "spike",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-plan-proposal.v1"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^C[0-9]{3,6}$"
    },
    "cycle_type": {
      "enum": [
        "feature",
        "spike",
        "refactor",
        "structural",
        "migration",
        "security",
        "perf",
        "integration",
        "compat",
        "corrective",
        "hotfix"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
      }
    },
    "non_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
      }
    },
    "surface": {
      "enum": [
        "local",
        "shared",
        "high-risk"
      ]
    },
    "usage_matrix": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "scenario",
          "constraint_difference",
          "test_refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "nominal",
              "alternate",
              "context"
            ]
          },
          "scenario": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
          },
          "constraint_difference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
          },
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^TEST-[0-9]{3,6}$"
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[0-9]{3,6}$"
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "method",
          "expected",
          "requirement_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TEST-[0-9]{3,6}$"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
          },
          "requirement_refs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,6}$"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "task",
          "intent",
          "paths",
          "requirement_refs",
          "test_refs",
          "done_criteria"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,6}$"
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&:]+$"
          },
          "intent": {
            "enum": [
              "implementation",
              "exploration"
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "operations"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192,
                  "pattern": "^[^\\r\\n\\u0000\\\\:*?\"<>|]+$"
                },
                "operations": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 5,
                  "items": {
                    "enum": [
                      "add",
                      "update",
                      "delete",
                      "move",
                      "move-destination"
                    ]
                  }
                }
              }
            }
          },
          "requirement_refs": {
            "type": "array",
            "minItems": 0,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,6}$"
            }
          },
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^TEST-[0-9]{3,6}$"
            }
          },
          "done_criteria": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
            }
          }
        }
      }
    },
    "architecture_notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
      }
    },
    "impact_notes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
          }
        }
      ]
    },
    "rollback_strategy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
        }
      ]
    },
    "compatibility_strategy": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
        }
      ]
    },
    "spike": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "learning_goal",
            "timebox",
            "decision_target"
          ],
          "properties": {
            "learning_goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
            },
            "timebox": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
            },
            "decision_target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
