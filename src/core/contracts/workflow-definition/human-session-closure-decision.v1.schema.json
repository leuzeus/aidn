{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-session-closure-decision.v1",
  "x-aidn-contract-version": "human-session-closure-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "rationale",
    "session_report",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "human-session-closure-decision.v1"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "close",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "session_report": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "open_loops",
            "blockers",
            "next_entry_point"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
            },
            "open_loops": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
              }
            },
            "blockers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
              }
            },
            "next_entry_point": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "choice": {
          "const": "close"
        },
        "session_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summary",
            "open_loops",
            "blockers",
            "next_entry_point"
          ],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
            },
            "open_loops": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
              }
            },
            "blockers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
              }
            },
            "next_entry_point": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
            }
          }
        }
      }
    },
    {
      "properties": {
        "choice": {
          "enum": [
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "session_report": {
          "type": "null"
        }
      }
    }
  ]
}
