{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-entry-output.v1",
  "x-aidn-contract-version": "standard-session-entry-output.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "operation_ref", "outcome", "effect_status", "facts", "observations", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-session-entry-output.v1" },
    "operation_ref": { "const": "session_entry_admit" },
    "outcome": { "enum": ["completed", "blocked"] },
    "effect_status": { "const": "no_effect" },
    "facts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "session_creation_allowed": { "type": "boolean" },
        "session_resume_allowed": { "type": "boolean" },
        "session_mode_pending": { "type": "boolean" },
        "mode_thinking": { "type": "boolean" },
        "mode_exploring": { "type": "boolean" },
        "mode_committing": { "type": "boolean" },
        "cycle_work_requested": { "type": "boolean" }
      }
    },
    "observations": { "type": "object", "additionalProperties": true },
    "evidence_refs": {
      "type": "array", "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["ref", "sha256"],
        "properties": {
          "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
