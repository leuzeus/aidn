{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-control-event.v1",
  "x-aidn-contract-version": "process-control-event.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "delivery_id", "authority_id", "source_kind", "source_event_id", "subject_sha256", "scope_id", "instance_id", "instance_sha256", "model_sha256", "instance_revision", "occurrence_id", "correlation_id", "event_key", "payload_sha256", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "process-control-event.v1" },
    "delivery_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "authority_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "source_kind": { "enum": ["human", "external"] },
    "source_event_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "subject_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "instance_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "instance_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "instance_revision": { "type": "integer", "minimum": 1, "maximum": 512 },
    "occurrence_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "correlation_id": { "type": "string", "minLength": 1, "maxLength": 512 },
    "event_key": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "payload_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha256"],
      "properties": { "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    } }
  }
}
