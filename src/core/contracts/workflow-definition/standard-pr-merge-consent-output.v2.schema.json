{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-merge-consent-output.v2",
  "x-aidn-contract-version": "standard-pr-merge-consent-output.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-merge-consent-output.v2"
    },
    "operation_ref": {
      "const": "session_pr_merge_consent"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "session_pr_merge_consent_accepted": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_sha256",
        "subject_sha256",
        "source_sha256",
        "choice",
        "inbox_id",
        "source_ref",
        "grant_sha256"
      ],
      "properties": {
        "question_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choice": {
          "enum": [
            "approve_merge",
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "grant_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 2
    }
  }
}
