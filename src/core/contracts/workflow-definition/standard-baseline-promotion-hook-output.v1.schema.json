{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-baseline-promotion-hook-output.v1",
  "x-aidn-contract-version": "standard-baseline-promotion-hook-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-baseline-promotion-hook-output.v1"
    },
    "operation_ref": {
      "const": "baseline_promotion_finalize"
    },
    "outcome": {
      "enum": [
        "completed",
        "reconciliation_required",
        "blocked"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "unknown",
        "no_effect"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "baseline_recorded": {
          "const": true
        },
        "baseline_promotion_completed": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "completed"
        },
        "effect_status": {
          "const": "confirmed"
        },
        "facts": {
          "required": [
            "baseline_recorded",
            "baseline_promotion_completed"
          ]
        },
        "evidence_refs": {
          "minItems": 6
        },
        "observations": {
          "required": [
            "cycle_id",
            "version",
            "event",
            "event_offset",
            "event_file",
            "committed"
          ],
          "properties": {
            "cycle_id": {
              "type": "string",
              "pattern": "^C[0-9]{3,6}$"
            },
            "version": {
              "type": "string",
              "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}(?:-[A-Za-z0-9][A-Za-z0-9.-]{0,31})?$",
              "maxLength": 64
            },
            "committed": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "reconciliation_required"
        },
        "effect_status": {
          "const": "unknown"
        },
        "facts": {
          "maxProperties": 0
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "blocked"
        },
        "effect_status": {
          "const": "no_effect"
        },
        "facts": {
          "maxProperties": 0
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    }
  ]
}
