{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-push-preparation.v1",
  "x-aidn-contract-version": "github-push-preparation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "remote_identity_sha256",
    "observed_sha256",
    "ref",
    "head",
    "pid",
    "prepared_at_ms",
    "objects"
  ],
  "properties": {
    "contract_version": {
      "const": "github-push-preparation.v1"
    },
    "remote_identity_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^refs/heads/"
    },
    "head": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "pid": {
      "type": "integer",
      "minimum": 1
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "objects": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  }
}
