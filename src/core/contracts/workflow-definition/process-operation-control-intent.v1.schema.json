{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-operation-control-intent.v1",
  "x-aidn-contract-version": "process-operation-control-intent.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation_id", "revision", "attempts", "key_id", "authentication"],
  "properties": {
    "contract_version": { "const": "process-operation-control-intent.v1" },
    "operation_id": { "type": "string", "pattern": "^op_[a-f0-9]{40}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "key_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authentication": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "attempts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["action", "plan", "grant", "inventory", "instance_sha256", "journal_sha256", "receipt_sha256", "audit_sha256", "resource_fence"],
        "properties": {
          "action": { "enum": ["disposition", "acceptance"] },
          "plan": { "type": "object" },
          "grant": { "type": ["object", "null"] },
          "inventory": { "type": "object" },
          "instance_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "journal_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "receipt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "audit_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "resource_fence": {
            "type": "object", "additionalProperties": false,
            "required": ["record", "previous_sha256"],
            "properties": {
              "record": { "type": "object" },
              "previous_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    }
  }
}
