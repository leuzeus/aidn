{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-operation-binding.v1",
  "x-aidn-contract-version": "process-operation-binding.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "id", "revision", "executor_kind", "effect_class", "skill_id", "input_contract", "output_contract", "rule_refs", "allowed_modes", "implementation_sha256"],
  "properties": {
    "contract_version": { "const": "process-operation-binding.v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "executor_kind": { "enum": ["deterministic", "human", "external"] },
    "effect_class": { "enum": ["read-only", "preview", "projector", "mutating", "executor"] },
    "skill_id": { "type": ["string", "null"], "maxLength": 64 },
    "input_contract": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "output_contract": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$" },
    "rule_refs": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "pattern": "^SPEC-R[0-9]{2}$" } },
    "allowed_modes": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "enum": ["THINKING", "EXPLORING", "COMMITTING", "UNKNOWN"] } },
    "implementation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
