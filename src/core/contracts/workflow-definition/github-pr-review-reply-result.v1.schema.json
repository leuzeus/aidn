{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-pr-review-reply-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "effect_status",
    "action",
    "operation_id",
    "repository_id",
    "pull_request_id",
    "head_oid",
    "base_oid",
    "thread_id",
    "target_comment_id",
    "reply_id",
    "actor_id",
    "body_sha256",
    "published_at",
    "observed_until"
  ],
  "properties": {
    "contract_version": {
      "const": "github-pr-review-reply-result.v1"
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect"
      ]
    },
    "action": {
      "enum": [
        "published",
        "recovered"
      ]
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
    },
    "pull_request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
    },
    "head_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "base_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "thread_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
    },
    "target_comment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
    },
    "reply_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=-]{1,256}$"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_until": {
      "type": "string",
      "format": "date-time"
    }
  }
}
