{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/native-owner-disposition-authorization-request.v2",
  "x-aidn-contract-version": "native-owner-disposition-authorization-request.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "action",
    "nonce",
    "requested_at_ms",
    "plan_sha256",
    "dispatch_id",
    "journal_id",
    "generation",
    "instance_id",
    "instance_sha256",
    "scope_id",
    "model_sha256",
    "configuration_sha256",
    "profile",
    "post_assignment_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "native-owner-disposition-authorization-request.v2"
    },
    "action": {
      "const": "native_owner_retire"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[a-f0-9-]{36}$"
    },
    "requested_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatch_id": {
      "type": "string",
      "pattern": "^native_dispatch_[a-f0-9]{40}$"
    },
    "journal_id": {
      "type": "string",
      "pattern": "^native_[a-f0-9]{40}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "profile": {
      "const": "admitted_post_assignment"
    },
    "post_assignment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
