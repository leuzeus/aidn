{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-close-plan.v1",
  "x-aidn-contract-version": "standard-cycle-close-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "decision_material_sha256",
    "context_sha256",
    "scope_sha256",
    "boundary_sha256",
    "cycle_path",
    "target_state",
    "changes"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-close-plan.v1"
    },
    "operation_ref": {
      "const": "cycle_close_record"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_operation_id"
      ],
      "properties": {
        "decision_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "decision_material_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "cycle_path": {
      "type": "string",
      "pattern": "^cycles/C[0-9]{3,6}-[a-z]+-[A-Za-z0-9._-]+$"
    },
    "target_state": {
      "enum": [
        "DONE",
        "NO_GO",
        "DROPPED"
      ]
    },
    "changes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before_sha256",
          "before_metadata_sha256",
          "text_chunks",
          "after_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "before_metadata_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
