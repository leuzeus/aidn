{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-handoff-admission-output.v1",
  "x-aidn-contract-version": "standard-handoff-admission-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "observations",
    "facts",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-handoff-admission-output.v1"
    },
    "operation_ref": {
      "const": "handoff_admit"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect",
        "unknown"
      ]
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "publication_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "resource_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packet_metadata_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "admitted": {
          "type": "boolean"
        },
        "admission_status": {
          "type": "string",
          "maxLength": 64
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "issues": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "warnings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "permits_handoff": {
          "const": false
        },
        "permits_effects": {
          "const": false
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "handoff_packet_admitted": {
          "const": true
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 0,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
