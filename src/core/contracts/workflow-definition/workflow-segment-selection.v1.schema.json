{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/workflow-segment-selection.v1",
  "title": "workflow-segment-selection.v1",
  "x-aidn-contract-version": "workflow-segment-selection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "selection",
    "binding_sha256",
    "binding_revision",
    "definition",
    "compiler_version",
    "registry",
    "context_sha256",
    "compilation_sha256",
    "canonical_sha256",
    "step_id",
    "plan_sha256",
    "validation",
    "macro_progress",
    "authority"
  ],
  "properties": {
    "contract_version": {
      "const": "workflow-segment-selection.v1"
    },
    "selection": {
      "const": "explicit_segment"
    },
    "binding_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding_revision": {
      "type": "integer",
      "minimum": 1
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "revision",
        "sha256"
      ],
      "properties": {
        "workflow_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 96
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "compiler_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compilation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 96
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation": {
      "enum": [
        "compiled",
        "retained"
      ]
    },
    "macro_progress": {
      "const": "not_evaluated"
    },
    "authority": {
      "const": "existing_agent_run_admission"
    }
  }
}
