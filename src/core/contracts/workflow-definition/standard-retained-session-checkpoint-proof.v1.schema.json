{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-retained-session-checkpoint-proof.v1",
  "x-aidn-contract-version": "standard-retained-session-checkpoint-proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_instance_id",
    "original_instance_sha256",
    "original_configuration_sha256",
    "journals_sha256",
    "native_journal_sha256",
    "session_id",
    "recovery_sha256",
    "dispatch_sha256",
    "closure_proof_sha256",
    "recovery_operation_id",
    "record_operation_id",
    "checkpoint_operation_id"
  ],
  "properties": {
    "original_instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "original_instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "journals_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "recovery_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "closure_proof_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recovery_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "record_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "checkpoint_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    }
  }
}
