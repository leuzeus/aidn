{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-project-authorization.v1",
  "x-aidn-contract-version": "standard-project-authorization.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "project_id", "runtime_scope_id", "revision", "previous_sha256", "principals", "signature"],
  "properties": {
    "contract_version": { "const": "standard-project-authorization.v1" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "runtime_scope_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "revision": { "type": "integer", "minimum": 1 },
    "previous_sha256": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }]
    },
    "principals": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority_id", "public_key", "decisions"],
        "properties": {
          "authority_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "public_key": { "type": "string", "minLength": 1, "maxLength": 512 },
          "codex_form": {
            "type": "object",
            "additionalProperties": false,
            "required": ["thread_id", "client"],
            "properties": {
              "thread_id": { "type": "string", "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$", "minLength": 36, "maxLength": 36 },
              "client": { "const": "codex-desktop-windows" }
            }
          },
          "decisions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["question_contract", "choices"],
              "properties": {
                "question_contract": { "type": "string", "pattern": "^standard-[a-z0-9-]+-question\\.v[1-9][0-9]*$", "maxLength": 140 },
                "choices": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,95}$" }
                }
              }
            }
          }
        }
      }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  }
}
