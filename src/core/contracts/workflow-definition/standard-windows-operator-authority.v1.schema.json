{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-windows-operator-authority.v1",
  "x-aidn-contract-version": "standard-windows-operator-authority.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "project_id", "runtime_scope_id", "thread_id", "origin", "operator_sid", "decisions", "credential_id", "public_key"],
  "properties": {
    "contract_version": { "const": "standard-windows-operator-authority.v1" },
    "project_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "runtime_scope_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "thread_id": { "type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$" },
    "origin": { "type": "string", "pattern": "^http://localhost:[1-9][0-9]{3,4}$" },
    "operator_sid": { "type": "string", "pattern": "^S-1-5-21(?:-[0-9]{1,10}){4}$" },
    "decisions": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["question_contract", "choices"],
        "properties": {
          "question_contract": { "type": "string", "maxLength": 100, "pattern": "^standard-[a-z-]+-question\\.v[1-9][0-9]*$" },
          "choices": { "type": "array", "minItems": 1, "maxItems": 48, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }
        }
      }
    },
    "credential_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,1366}$" },
    "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{122}$" }
  }
}
