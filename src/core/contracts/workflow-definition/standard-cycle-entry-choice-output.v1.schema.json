{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-entry-choice-output.v1",
  "x-aidn-contract-version": "standard-cycle-entry-choice-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-entry-choice-output.v1"
    },
    "operation_ref": {
      "const": "cycle_entry_choice_decision"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_entry_selection_requested"
          ],
          "properties": {
            "cycle_entry_selection_requested": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      ]
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbox_id",
        "source_ref",
        "source_sha256",
        "subject_sha256",
        "choice",
        "selection",
        "implementation_authorized"
      ],
      "properties": {
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choice": {
          "enum": [
            "select_cycle",
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "selection": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cycle_id",
                "carryover_decisions"
              ],
              "properties": {
                "cycle_id": {
                  "type": "string",
                  "pattern": "^C[0-9]{3,6}$"
                },
                "carryover_decisions": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "cycle_id",
                      "action",
                      "outcome",
                      "rationale"
                    ],
                    "properties": {
                      "cycle_id": {
                        "type": "string",
                        "pattern": "^C[0-9]{3,6}$"
                      },
                      "action": {
                        "enum": [
                          "integrate_now",
                          "import_now",
                          "defer",
                          "drop"
                        ]
                      },
                      "outcome": {
                        "enum": [
                          null,
                          "NO_GO",
                          "DROPPED"
                        ]
                      },
                      "rationale": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "implementation_authorized": {
          "const": false
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
