{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-change-request-output.v1",
  "x-aidn-contract-version": "standard-drift-change-request-output.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "operation_ref", "outcome", "effect_status", "facts", "observations", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-drift-change-request-output.v1" },
    "operation_ref": { "const": "drift_change_request_record" },
    "outcome": { "enum": ["completed", "blocked", "failed", "reconciliation_required"] },
    "effect_status": { "enum": ["no_effect", "confirmed", "unknown"] },
    "facts": { "type": "object", "additionalProperties": false, "properties": {
      "drift_change_request_recorded": { "const": true }, "drift_recovery_required": { "const": true }, "drift_check_completed": { "const": false }
    } },
    "observations": { "type": "object", "additionalProperties": true },
    "evidence_refs": { "type": "array", "maxItems": 15, "items": { "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"], "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
  }
}
