{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-baseline-promotion-request.v1",
  "x-aidn-contract-version": "standard-baseline-promotion-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_operation_id",
    "closure_operation_id",
    "instance_id",
    "scope_id",
    "cycle_id",
    "cycle_path",
    "baseline_sha256",
    "history_sha256",
    "version",
    "summary",
    "evidence_refs",
    "product_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-baseline-promotion-request.v1"
    },
    "decision_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "closure_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cycle_id": {
      "type": "string",
      "pattern": "^C[0-9]{3,6}$"
    },
    "cycle_path": {
      "type": "string",
      "pattern": "^cycles/C[0-9]{3,6}-[a-z]+-[A-Za-z0-9._-]+$"
    },
    "baseline_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "history_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}(?:-[A-Za-z0-9][A-Za-z0-9.-]{0,31})?$",
      "maxLength": 64
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "product_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
