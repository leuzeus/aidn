{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-create-catalog.v1",
  "x-aidn-contract-version": "standard-cycle-create-catalog.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "component_id",
    "revision",
    "scope",
    "model",
    "specification",
    "bindings"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-create-catalog.v1"
    },
    "component_id": {
      "const": "aidn-standard-cycle-create"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "complete_standard_workflow",
        "entry_conditions",
        "remaining_activities"
      ],
      "properties": {
        "kind": {
          "const": "new_cycle_scaffold_component"
        },
        "complete_standard_workflow": {
          "const": false
        },
        "entry_conditions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "owned_session_with_selected_mode",
              "explicit_cycle_parameters_and_effect_grant"
            ]
          }
        },
        "remaining_activities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "model_id",
        "revision"
      ],
      "properties": {
        "path": {
          "const": "package/catalogs/process-models/aidn-standard-cycle-create.v1.json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "model_id": {
          "const": "aidn-standard-cycle-create"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "const": "docs/SPEC.md"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "binding",
          "skill_source"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "binding": {
            "type": "object"
          },
          "skill_source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "enum": [
                  "scaffold/codex/aidn-context-reload/SKILL.md",
                  "scaffold/codex/aidn-cycle-create/SKILL.md",
                  "scaffold/codex/aidn-branch-cycle-audit/SKILL.md"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    }
  }
}
