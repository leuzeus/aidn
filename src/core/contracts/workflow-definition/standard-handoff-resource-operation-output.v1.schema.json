{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-handoff-resource-operation-output.v1",
  "x-aidn-contract-version": "standard-handoff-resource-operation-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-handoff-resource-operation-output.v1"
    },
    "operation_ref": {
      "const": "handoff_resources_observe"
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handoff_resource_snapshot_observed"
      ],
      "properties": {
        "handoff_resource_snapshot_observed": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_operation_id",
        "publication_output_sha256",
        "packet_sha256",
        "packet_metadata_sha256",
        "resource_result",
        "permits_handoff",
        "permits_effects"
      ],
      "properties": {
        "publication_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "publication_output_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "packet_metadata_sha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          ]
        },
        "resource_result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "request_sha256",
            "instance_id",
            "instance_sha256",
            "scope_id",
            "model_sha256",
            "configuration_sha256",
            "physical_root_sha256",
            "inventory_material_sha256",
            "native_history_sha256",
            "ownership_sha256",
            "observation_sha256",
            "authority_id",
            "evidence_class",
            "observed_at_ms",
            "unknown_business_operations",
            "complete_resource_closure",
            "snapshot_only",
            "permits_effects",
            "permits_handoff",
            "written",
            "key_id",
            "authentication"
          ],
          "properties": {
            "contract_version": {
              "const": "standard-handoff-resource-result.v1"
            },
            "request_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "instance_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "instance_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "scope_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "configuration_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "physical_root_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inventory_material_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "native_history_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "ownership_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "observation_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authority_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,95}$"
            },
            "evidence_class": {
              "enum": [
                "fixture",
                "native"
              ]
            },
            "observed_at_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unknown_business_operations": {
              "type": "array",
              "maxItems": 10000,
              "items": {
                "type": "string",
                "pattern": "^op_[a-f0-9]{40}$"
              }
            },
            "complete_resource_closure": {
              "const": true
            },
            "snapshot_only": {
              "const": true
            },
            "permits_effects": {
              "const": false
            },
            "permits_handoff": {
              "const": false
            },
            "written": {
              "const": false
            },
            "key_id": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "authentication": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "permits_handoff": {
          "const": false
        },
        "permits_effects": {
          "const": false
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
