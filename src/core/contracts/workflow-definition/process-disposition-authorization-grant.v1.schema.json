{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-disposition-authorization-grant.v1",
  "x-aidn-contract-version": "process-disposition-authorization-grant.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority_id",
    "authorized",
    "request_sha256",
    "principal_sha256",
    "grant_sha256",
    "observed_at_ms",
    "expires_at_ms",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "process-disposition-authorization-grant.v1"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "authorized": {
      "const": true
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "principal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "grant_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
