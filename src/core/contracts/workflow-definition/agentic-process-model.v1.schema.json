{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/agentic-process-model.v1",
  "title": "Internal agentic-process-model.v1",
  "x-aidn-contract-version": "agentic-process-model.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "model_id",
    "revision",
    "participants",
    "roles",
    "policies",
    "nodes",
    "entry"
  ],
  "properties": {
    "contract_version": {
      "const": "agentic-process-model.v1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          }
        }
      },
      "minItems": 1,
      "maxItems": 32
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "action",
          "skills"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 128
          }
        }
      },
      "minItems": 1,
      "maxItems": 32
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "assurance_profile",
          "mode",
          "independent_review",
          "context_isolation_required",
          "required_permissions",
          "allowed_permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "assurance_profile": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "mode": {
            "enum": [
              "THINKING",
              "EXPLORING",
              "COMMITTING"
            ]
          },
          "independent_review": {
            "type": "boolean"
          },
          "context_isolation_required": {
            "type": "boolean"
          },
          "required_permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 128
          },
          "allowed_permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "minItems": 0,
            "maxItems": 128
          }
        }
      },
      "minItems": 1,
      "maxItems": 32
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "participant_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "kind": {
            "enum": [
              "activity",
              "sequence",
              "xor",
              "and",
              "or",
              "event",
              "loop",
              "multi_instance",
              "call",
              "complex",
              "mixed",
              "event_start_exclusive",
              "event_start_parallel",
              "message_review"
            ]
          },
          "participant_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "role_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "policy_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "children": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "minItems": 1,
            "maxItems": 32
          },
          "child": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "until": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$",
            "maxLength": 64
          },
          "max_iterations": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "maxLength": 64
            },
            "minItems": 0,
            "maxItems": 32
          },
          "ordering": {
            "enum": [
              "sequential",
              "parallel"
            ]
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "flow_id",
                "node_id"
              ],
              "properties": {
                "flow_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "node_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                  "maxLength": 64
                },
                "condition": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                      "maxLength": 64
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "event_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$",
                  "maxLength": 64
                }
              }
            },
            "minItems": 2,
            "maxItems": 16
          },
          "specification": {
            "type": "object"
          }
        }
      },
      "minItems": 1,
      "maxItems": 128
    },
    "entry": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "maxLength": 64
    }
  }
}
