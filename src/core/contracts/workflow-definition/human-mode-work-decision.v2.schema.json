{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-mode-work-decision.v2",
  "x-aidn-contract-version": "human-mode-work-decision.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "evidence_refs",
    "rationale",
    "handoff"
  ],
  "properties": {
    "contract_version": {
      "const": "human-mode-work-decision.v2"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "continue_analysis",
        "handoff",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "handoff": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "next_agent_role",
            "next_agent_action",
            "next_agent_goal",
            "handoff_note",
            "from_agent_role",
            "from_agent_action"
          ],
          "properties": {
            "contract_version": {
              "const": "standard-handoff-publication-input.v1"
            },
            "next_agent_role": {
              "enum": [
                "coordinator",
                "executor",
                "auditor",
                "repair"
              ]
            },
            "next_agent_action": {
              "enum": [
                "reanchor",
                "implement",
                "audit",
                "analyze",
                "repair",
                "relay",
                "close",
                "coordinate"
              ]
            },
            "next_agent_goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[^\\r\\n]+$"
            },
            "handoff_note": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\r\\n]*$"
            },
            "from_agent_role": {
              "enum": [
                "coordinator",
                "executor",
                "auditor",
                "repair"
              ]
            },
            "from_agent_action": {
              "enum": [
                "reanchor",
                "implement",
                "audit",
                "analyze",
                "repair",
                "relay",
                "close",
                "coordinate"
              ]
            }
          }
        }
      ]
    }
  }
}
