{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-incident-tracking-source.v1",
  "title": "standard-pr-incident-tracking-source.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "instance_id",
    "scope_id",
    "incident_id",
    "origin_operation_id",
    "origin_receipt_sha256",
    "checkpoint_sha256",
    "session_id",
    "owner",
    "severity",
    "rule_pins",
    "resolution"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-incident-tracking-source.v1"
    },
    "instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "incident_id": {
      "type": "string",
      "pattern": "^INC-TMP-[0-9]{8}-[0-9]{6}-[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "origin_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "origin_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "owner": {
      "type": "string",
      "pattern": "^human:[a-z][a-z0-9_-]{0,63}$"
    },
    "severity": {
      "enum": [
        "L1_LOW",
        "L2_MEDIUM"
      ]
    },
    "rule_pins": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "enum": [
              "SPEC.md",
              "WORKFLOW.md"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "resolution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "completion_operation_id",
            "completion_receipt_sha256",
            "plan_sha256",
            "alignment_operation_id",
            "alignment_receipt_sha256"
          ],
          "properties": {
            "completion_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "completion_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "alignment_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "alignment_receipt_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
