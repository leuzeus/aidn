{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-retained-task-work-output.v1",
  "x-aidn-contract-version": "standard-retained-task-work-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-retained-task-work-output.v1"
    },
    "operation_ref": {
      "const": "cycle_retained_task_work_observe"
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_work_observed",
        "cycle_validation_required"
      ],
      "properties": {
        "cycle_work_observed": {
          "const": true
        },
        "cycle_validation_required": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_operation_id",
        "task_operation_id",
        "source_kind",
        "source",
        "task",
        "producer",
        "scope_sha256",
        "after_product_sha256",
        "product_snapshot",
        "validation_test_refs",
        "validation",
        "implementation_authorized",
        "current_native_work_evidence",
        "authorship"
      ],
      "properties": {
        "implementation_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "task_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "source_kind": {
          "const": "retained_native_work"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "original_instance_id",
            "original_instance_sha256",
            "recovery_operation_id",
            "recovery_sha256",
            "original_configuration_sha256",
            "work_operation_id",
            "work_journal_sha256",
            "work_output_sha256",
            "native_journal_sha256",
            "dispatch_sha256",
            "validation_journal_sha256"
          ],
          "properties": {
            "original_instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "original_instance_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "recovery_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "recovery_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "original_configuration_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "work_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "work_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "work_output_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "native_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "dispatch_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "validation_journal_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "task",
            "intent",
            "paths",
            "requirement_refs",
            "test_refs",
            "done_criteria"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^TASK-[0-9]{3,6}$"
            },
            "task": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&:]+$"
            },
            "intent": {
              "enum": [
                "implementation",
                "exploration"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "operations"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 192,
                    "pattern": "^[^\\r\\n\\u0000\\\\:*?\"<>|]+$"
                  },
                  "operations": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                      "enum": [
                        "add",
                        "update",
                        "delete",
                        "move",
                        "move-destination"
                      ]
                    }
                  }
                }
              }
            },
            "requirement_refs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^REQ-[0-9]{3,6}$"
              }
            },
            "test_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^TEST-[0-9]{3,6}$"
              }
            },
            "done_criteria": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^[^\\r\\n\\u0000`#|<>\\\\\\[\\]{}&]+$"
              }
            }
          }
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instance_id",
            "model_sha256",
            "occurrence_id",
            "result_id"
          ],
          "properties": {
            "instance_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "model_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "occurrence_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "result_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_product_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "product_snapshot": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "present"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 192
              },
              "present": {
                "type": "boolean"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1048576
              }
            }
          }
        },
        "validation_test_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "validation": {
          "const": "not_executed"
        },
        "implementation_authorized": {
          "const": false
        },
        "current_native_work_evidence": {
          "const": false
        },
        "authorship": {
          "const": "retained_native_producer_not_current_activity"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
