{
  "$schema": "http://json-schema.org/draft-07/schema#", "$id": "aidn://contracts/workflow-definition/standard-drift-output.v1",
  "x-aidn-contract-version": "standard-drift-output.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "operation_ref", "outcome", "effect_status", "facts", "observations", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-drift-output.v1" },
    "operation_ref": { "enum": ["drift_report_evaluate", "drift_check_finalize"] },
    "outcome": { "enum": ["completed", "blocked", "deferred", "rejected", "cancelled", "failed", "reconciliation_required"] },
    "effect_status": { "enum": ["no_effect", "confirmed", "unknown"] },
    "facts": { "type": "object", "additionalProperties": false, "properties": {
      "drift_report_available": { "type": "boolean" }, "drift_present": { "type": "boolean" }, "drift_recovery_required": { "type": "boolean" }, "drift_context_complete": { "type": "boolean" }, "drift_check_completed": { "type": "boolean" }
    } },
    "observations": { "type": "object", "additionalProperties": true },
    "evidence_refs": { "type": "array", "maxItems": 15, "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    } }
  }
}
