{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-operation-receipt.v1",
  "x-aidn-contract-version": "process-operation-receipt.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "receipt_id", "operation_id", "intent_sha256", "authority_id", "outcome", "effect_status", "output_sha256", "facts", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "process-operation-receipt.v1" },
    "receipt_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "operation_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "intent_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "authority_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "outcome": { "enum": ["completed", "failed", "rejected", "blocked", "deferred", "cancelled", "reconciliation_required"] },
    "effect_status": { "enum": ["no_effect", "confirmed", "unknown"] },
    "output_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "facts": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "boolean" } },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 16, "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha256"],
      "properties": { "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
    } }
  }
}
