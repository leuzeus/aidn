{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-operation-output.v1",
  "x-aidn-contract-version": "standard-operation-output.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "operation_ref", "outcome", "effect_status", "facts", "observations", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-operation-output.v1" },
    "operation_ref": { "enum": ["context_reload", "session_admit", "session_initialize"] },
    "outcome": { "enum": ["completed", "blocked", "reconciliation_required"] },
    "effect_status": { "enum": ["no_effect", "confirmed", "unknown"] },
    "facts": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "context_loaded": { "type": "boolean" },
        "session_creation_allowed": { "type": "boolean" },
        "session_resume_allowed": { "type": "boolean" },
        "session_initialized": { "type": "boolean" },
        "session_mode_pending": { "type": "boolean" }
      }
    },
    "observations": { "type": "object", "additionalProperties": true },
    "evidence_refs": {
      "type": "array", "maxItems": 32,
      "items": { "type": "object", "additionalProperties": false, "required": ["ref", "sha256"],
        "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
    }
  }
}
