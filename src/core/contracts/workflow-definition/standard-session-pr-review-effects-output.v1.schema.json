{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-pr-review-effects-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-pr-review-effects-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_review_effects_verify"
    },
    "outcome": {
      "enum": [
        "completed",
        "deferred",
        "blocked"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session_pr_review_effects_verified"
          ],
          "properties": {
            "session_pr_review_effects_verified": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {}
        }
      ]
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "proof"
          ],
          "properties": {
            "proof": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "triage_operation_id",
                "update_operation_id",
                "source_sha256",
                "repository_id",
                "pull_request_id",
                "head_oid",
                "base_oid",
                "observed_from",
                "observed_until",
                "thread_observation_sha256",
                "review_evidence_sha256",
                "reply_proof_sha256",
                "reply_count",
                "resolved_thread_count"
              ],
              "properties": {
                "triage_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "update_operation_id": {
                  "type": "string",
                  "pattern": "^op_[a-f0-9]{40}$"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "repository_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "pull_request_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "head_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "base_oid": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40}$"
                },
                "observed_from": {
                  "type": "string",
                  "format": "date-time"
                },
                "observed_until": {
                  "type": "string",
                  "format": "date-time"
                },
                "thread_observation_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "review_evidence_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "reply_proof_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "reply_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "resolved_thread_count": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 500
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
