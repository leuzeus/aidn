{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-retained-merge-capture-selection.v3",
  "x-aidn-contract-version": "standard-retained-merge-capture-selection.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-retained-merge-capture-selection.v3"
    },
    "operation_ref": {
      "const": "session_pr_retained_merge_select"
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retained_external_merge_capture_requested",
        "retained_post_merge_requested",
        "retained_post_merge_decision_requested"
      ],
      "properties": {
        "retained_external_merge_capture_requested": {
          "type": "boolean"
        },
        "retained_post_merge_requested": {
          "type": "boolean"
        },
        "retained_post_merge_decision_requested": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fetch_operation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "decision_operation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^op_[a-f0-9]{40}$"
        }
      },
      "required": [
        "fetch_operation_id",
        "decision_operation_id"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 0
    }
  }
}
