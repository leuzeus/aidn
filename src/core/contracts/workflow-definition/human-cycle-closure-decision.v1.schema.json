{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-cycle-closure-decision.v1",
  "x-aidn-contract-version": "human-cycle-closure-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "rationale",
    "risk_acceptances",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "human-cycle-closure-decision.v1"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "retain",
        "no_go",
        "drop",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "risk_acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "rationale"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 11,
            "maxLength": 32,
            "pattern": "^FINDING-[0-9]{3,6}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "minItems": 0,
      "maxItems": 64
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      },
      "minItems": 1,
      "maxItems": 8
    }
  }
}
