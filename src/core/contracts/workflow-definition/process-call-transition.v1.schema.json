{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/process-call-transition.v1",
  "x-aidn-contract-version": "process-call-transition.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "kind",
    "occurrence_id",
    "resolution",
    "witnesses"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "enum": [
        "call_enter",
        "call_return"
      ]
    },
    "occurrence_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "instance_sha256",
        "occurrence_id",
        "bindings_sha256",
        "input",
        "sources"
      ],
      "properties": {
        "contract_version": {
          "const": "process-resolved-input.v3"
        },
        "instance_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "occurrence_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "bindings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "type": "object",
          "maxProperties": 32
        },
        "sources": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "source",
              "occurrence_id",
              "operation_id",
              "sha256"
            ],
            "properties": {
              "field": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "literal",
                  "parameter",
                  "occurrence_id",
                  "operation_id",
                  "operation_input",
                  "operation_output",
                  "item",
                  "call_output"
                ]
              },
              "occurrence_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 256
              },
              "operation_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "witnesses": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "phase",
          "preview",
          "intent",
          "results"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "phase": {
            "const": "receipted"
          },
          "preview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "input"
            ],
            "properties": {
              "input": {
                "type": "object"
              }
            }
          },
          "intent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_version",
              "operation_id",
              "binding_ref",
              "binding_sha256",
              "input_sha256",
              "preconditions_sha256",
              "authorization_sha256",
              "authority_id",
              "scope_id",
              "instance_id",
              "instance_sha256",
              "model_sha256",
              "occurrence_id",
              "instance_revision"
            ],
            "properties": {
              "contract_version": {
                "const": "process-operation-intent.v1"
              },
              "operation_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "binding_ref": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "binding_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "input_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "preconditions_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "authorization_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              },
              "authority_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "scope_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "instance_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "instance_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "model_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "occurrence_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "instance_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 512
              }
            }
          },
          "results": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "output",
                "receipt"
              ],
              "properties": {
                "output": {},
                "receipt": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "contract_version",
                    "receipt_id",
                    "operation_id",
                    "intent_sha256",
                    "authority_id",
                    "outcome",
                    "effect_status",
                    "output_sha256",
                    "facts",
                    "evidence_refs"
                  ],
                  "properties": {
                    "contract_version": {
                      "const": "process-operation-receipt.v1"
                    },
                    "receipt_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "operation_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "intent_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "authority_id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "outcome": {
                      "enum": [
                        "completed",
                        "failed",
                        "rejected",
                        "blocked",
                        "deferred",
                        "cancelled",
                        "reconciliation_required"
                      ]
                    },
                    "effect_status": {
                      "enum": [
                        "no_effect",
                        "confirmed",
                        "unknown"
                      ]
                    },
                    "output_sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "facts": {
                      "type": "object",
                      "maxProperties": 128,
                      "additionalProperties": {
                        "type": "boolean"
                      }
                    },
                    "evidence_refs": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 16,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "ref",
                          "sha256"
                        ],
                        "properties": {
                          "ref": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
