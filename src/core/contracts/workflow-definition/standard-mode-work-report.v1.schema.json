{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-mode-work-report.v1",
  "x-aidn-contract-version": "standard-mode-work-report.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "context_sha256",
    "mode",
    "objective",
    "disposition",
    "findings",
    "rationale",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-mode-work-report.v1"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "THINKING",
        "EXPLORING"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "disposition": {
      "enum": [
        "thinking_complete",
        "nonretained",
        "retain_requested",
        "waiting"
      ]
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
