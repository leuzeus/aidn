{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-spike-initialize-plan.v1",
  "x-aidn-contract-version": "standard-spike-initialize-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input",
    "prepared_at_ms",
    "decision_sha256",
    "review",
    "inner"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-spike-initialize-plan.v1"
    },
    "input": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "aidn://contracts/workflow-definition/standard-spike-initialize-input.v1",
      "x-aidn-contract-version": "standard-spike-initialize-input.v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "decision_operation_id"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-spike-initialize-input.v1"
        },
        "decision_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "decision_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "analysis",
        "inventory_sha256",
        "minimum_cycle_number",
        "continuity_sha256",
        "session_sha256",
        "current_sha256"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-spike-review.v1"
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "session_id",
            "mode",
            "context_sha256",
            "product_sha256",
            "head",
            "branch",
            "report",
            "report_sha256",
            "producer",
            "reference"
          ],
          "properties": {
            "contract_version": {
              "const": "standard-mode-work-review.v1"
            },
            "session_id": {
              "type": "string",
              "pattern": "^S[0-9]{3,6}$"
            },
            "mode": {
              "enum": [
                "THINKING",
                "EXPLORING"
              ]
            },
            "context_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "product_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            },
            "branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "report": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_version",
                "context_sha256",
                "mode",
                "objective",
                "disposition",
                "findings",
                "rationale",
                "evidence_refs"
              ],
              "properties": {
                "contract_version": {
                  "const": "standard-mode-work-report.v1"
                },
                "context_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "mode": {
                  "enum": [
                    "THINKING",
                    "EXPLORING"
                  ]
                },
                "objective": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "disposition": {
                  "enum": [
                    "thinking_complete",
                    "nonretained",
                    "retain_requested",
                    "waiting"
                  ]
                },
                "findings": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "evidence_refs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ref",
                      "sha256"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                }
              }
            },
            "report_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "producer": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "instance_id",
                "model_sha256",
                "occurrence_id",
                "result_id"
              ],
              "properties": {
                "instance_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "model_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "occurrence_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "result_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              }
            },
            "reference": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "minimum_cycle_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "continuity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "session_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "current_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "inner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_apply",
        "plan",
        "plan_sha256"
      ],
      "properties": {
        "can_apply": {
          "const": true
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "operation_ref",
            "input",
            "prepared_at_ms",
            "scope",
            "mode",
            "branch_name",
            "cycle_path",
            "session_path",
            "latest_cycle_branch",
            "templates",
            "changes",
            "spike_selection"
          ],
          "properties": {
            "contract_version": {
              "const": "standard-cycle-initialize-plan.v3"
            },
            "operation_ref": {
              "const": "cycle_initialize"
            },
            "input": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "session_id",
                "cycle_id",
                "cycle_type",
                "title",
                "objective",
                "continuity_rule",
                "base_branch"
              ],
              "properties": {
                "session_id": {
                  "type": "string",
                  "pattern": "^S[0-9]{3,6}$"
                },
                "cycle_id": {
                  "type": "string",
                  "pattern": "^C[0-9]{3,6}$"
                },
                "cycle_type": {
                  "enum": [
                    "feature",
                    "spike",
                    "refactor",
                    "structural",
                    "migration",
                    "security",
                    "perf",
                    "integration",
                    "compat",
                    "corrective",
                    "hotfix"
                  ]
                },
                "title": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                },
                "objective": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 512,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "continuity_rule": {
                  "enum": [
                    "R1_STRICT_CHAIN",
                    "R2_SESSION_BASE_WITH_IMPORT"
                  ]
                },
                "base_branch": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9/_-]{0,127}$"
                }
              }
            },
            "prepared_at_ms": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "project",
                "persistence",
                "branch",
                "head"
              ],
              "properties": {
                "project": {
                  "type": "object"
                },
                "persistence": {
                  "type": "object"
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "head": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{40,64}$"
                }
              }
            },
            "mode": {
              "enum": [
                "COMMITTING",
                "EXPLORING"
              ]
            },
            "branch_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "cycle_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "session_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "latest_cycle_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "templates": {
              "type": "array",
              "minItems": 8,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 192
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "changes": {
              "type": "array",
              "minItems": 11,
              "maxItems": 11,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "before_sha256",
                  "after",
                  "after_sha256",
                  "before_metadata_sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 192
                  },
                  "before_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "after": {
                    "type": "string",
                    "maxLength": 1048576
                  },
                  "after_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "before_metadata_sha256": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            },
            "spike_selection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cycle_id",
                "title",
                "learning_goal",
                "timebox",
                "decision_target",
                "chosen_mode",
                "branch_action"
              ],
              "properties": {
                "cycle_id": {
                  "type": "string",
                  "pattern": "^C[0-9]{3,6}$"
                },
                "title": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                },
                "learning_goal": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 512,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "timebox": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "decision_target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "chosen_mode": {
                  "enum": [
                    "EXPLORING",
                    "COMMITTING"
                  ]
                },
                "branch_action": {
                  "enum": [
                    "recommend",
                    "create"
                  ]
                }
              }
            }
          }
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
