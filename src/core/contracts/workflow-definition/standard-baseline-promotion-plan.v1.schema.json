{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-baseline-promotion-plan.v1",
  "x-aidn-contract-version": "standard-baseline-promotion-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "request",
    "source_material_sha256",
    "context_sha256",
    "boundary_sha256",
    "changes"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-baseline-promotion-plan.v1"
    },
    "operation_ref": {
      "const": "baseline_promotion_record"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_operation_id"
      ],
      "properties": {
        "decision_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "decision_operation_id",
        "closure_operation_id",
        "instance_id",
        "scope_id",
        "cycle_id",
        "cycle_path",
        "baseline_sha256",
        "history_sha256",
        "version",
        "summary",
        "evidence_refs",
        "product_sha256"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-baseline-promotion-request.v1"
        },
        "decision_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "closure_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^C[0-9]{3,6}$"
        },
        "cycle_path": {
          "type": "string",
          "pattern": "^cycles/C[0-9]{3,6}-[a-z]+-[A-Za-z0-9._-]+$"
        },
        "baseline_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+(?:\\.[0-9]+){1,2}(?:-[A-Za-z0-9][A-Za-z0-9.-]{0,31})?$",
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "pattern": "^[^\\r\\n\\u0000-\\u001f]+$"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "product_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_material_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before_sha256",
          "before_metadata_sha256",
          "after_sha256",
          "text_chunks"
        ],
        "properties": {
          "path": {
            "enum": [
              "baseline/current.md",
              "baseline/history.md",
              "snapshots/context-snapshot.md",
              "index.md",
              "CURRENT-STATE.md"
            ]
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "before_metadata_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          }
        }
      }
    }
  }
}
