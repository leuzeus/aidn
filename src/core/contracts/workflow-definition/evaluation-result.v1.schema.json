{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/evaluation-result.v1",
  "x-aidn-contract-version": "evaluation-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evaluator_ref",
    "execution_status",
    "verdict",
    "reason_codes",
    "facts",
    "observed_subject",
    "evidence_refs",
    "details"
  ],
  "properties": {
    "contract_version": {
      "const": "evaluation-result.v1"
    },
    "evaluator_ref": {
      "type": "string",
      "minLength": 1
    },
    "execution_status": {
      "const": "completed"
    },
    "verdict": {
      "type": "string",
      "minLength": 1
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "observed_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "sha256"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "details": {
      "type": "object"
    }
  }
}
