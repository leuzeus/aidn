{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-execution-source-output.v1",
  "x-aidn-contract-version": "standard-cycle-execution-source-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-execution-source-output.v1"
    },
    "operation_ref": {
      "const": "cycle_execution_source_select"
    },
    "outcome": {
      "const": "completed"
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_execution_source_selected",
        "cycle_work_tasks_pending",
        "cycle_work_product_ready"
      ],
      "properties": {
        "cycle_execution_source_selected": {
          "const": true
        },
        "cycle_work_tasks_pending": {
          "type": "boolean"
        },
        "cycle_work_product_ready": {
          "type": "boolean"
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_operation_id",
        "implementation_operation_id",
        "implementation_source_kind",
        "phase_source_sha256",
        "context_sha256",
        "scope_sha256",
        "cycle_path",
        "task_count",
        "completed_task_ids",
        "remaining_task_ids",
        "imported_completed_task_ids",
        "implementation_authorized",
        "current_native_work_evidence",
        "current_validation_evidence"
      ],
      "properties": {
        "record_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "implementation_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "implementation_source_kind": {
          "enum": [
            "implementation_entry",
            "canonical_progress"
          ]
        },
        "phase_source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scope_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cycle_path": {
          "type": "string",
          "maxLength": 192
        },
        "task_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "completed_task_ids": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,6}$"
          }
        },
        "remaining_task_ids": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,6}$"
          }
        },
        "imported_completed_task_ids": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3,6}$"
          }
        },
        "implementation_authorized": {
          "const": false
        },
        "current_native_work_evidence": {
          "const": false
        },
        "current_validation_evidence": {
          "const": false
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
