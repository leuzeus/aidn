{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-pr-observation-output.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repository",
    "pull_request",
    "threads",
    "observed_from",
    "observed_until",
    "pagination",
    "consistency",
    "observation_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "github-pr-observation.v2"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name",
        "node_id"
      ],
      "properties": {
        "host": {
          "const": "github.com"
        },
        "owner": {
          "type": "string",
          "maxLength": 39,
          "minLength": 1
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "minLength": 1
        },
        "node_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "number",
        "head_oid",
        "head_ref",
        "base_ref",
        "state",
        "is_draft",
        "merged",
        "merge_oid",
        "updated_at",
        "base_oid"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "maxLength": 256,
          "minLength": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "head_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_ref": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "base_ref": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "MERGED"
          ]
        },
        "is_draft": {
          "type": "boolean"
        },
        "merged": {
          "type": "boolean"
        },
        "merge_oid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "base_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "threads": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "path",
          "line",
          "is_resolved",
          "is_outdated",
          "comments"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "path": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1
          },
          "line": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "is_resolved": {
            "type": "boolean"
          },
          "is_outdated": {
            "type": "boolean"
          },
          "comments": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node_id",
                "author_login",
                "author_type",
                "body_chunks",
                "body_sha256",
                "created_at",
                "updated_at",
                "commit_oid",
                "original_commit_oid",
                "author_node_id"
              ],
              "properties": {
                "node_id": {
                  "type": "string",
                  "maxLength": 256,
                  "minLength": 1
                },
                "author_login": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256,
                  "minLength": 1
                },
                "author_type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 256,
                  "minLength": 1
                },
                "body_chunks": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": {
                    "type": "string",
                    "maxLength": 8192
                  }
                },
                "body_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "created_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "commit_oid": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40}$"
                },
                "original_commit_oid": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{40}$"
                },
                "author_node_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "observed_from": {
      "type": "string",
      "format": "date-time"
    },
    "observed_until": {
      "type": "string",
      "format": "date-time"
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "thread_pages",
        "comment_pages",
        "complete"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 1
        },
        "thread_pages": {
          "type": "integer",
          "minimum": 1
        },
        "comment_pages": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "const": true
        }
      }
    },
    "consistency": {
      "const": "head-and-pr-metadata-rechecked"
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
