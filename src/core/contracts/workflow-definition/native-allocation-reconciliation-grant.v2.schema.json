{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/native-allocation-reconciliation-grant.v2",
  "x-aidn-contract-version": "native-allocation-reconciliation-grant.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority_id",
    "source_event_id",
    "request_sha256",
    "consumption",
    "closure",
    "evidence_refs",
    "profile",
    "post_assignment_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "native-allocation-reconciliation-grant.v2"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "responses_observed",
        "response_sha256",
        "storage_debit_bytes",
        "native_usage_sha256"
      ],
      "properties": {
        "responses_observed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "response_sha256": {
          "type": "array",
          "maxItems": 120,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "minItems": 1
        },
        "storage_debit_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "native_usage_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "request_sha256",
        "inventory_sha256",
        "observed_at_ms",
        "complete",
        "active_resources",
        "evidence_class",
        "resources"
      ],
      "properties": {
        "contract_version": {
          "const": "native-resource-closure.v1"
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inventory_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "observed_at_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "complete": {
          "const": true
        },
        "active_resources": {
          "const": 0
        },
        "evidence_class": {
          "enum": [
            "fixture",
            "native"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 160,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_sha256",
              "state",
              "evidence_refs"
            ],
            "properties": {
              "resource_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "state": {
                "const": "closed"
              },
              "evidence_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "sha256"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "profile": {
      "const": "admitted_post_assignment"
    },
    "post_assignment_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
