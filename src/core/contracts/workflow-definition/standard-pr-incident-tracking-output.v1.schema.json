{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-incident-tracking-output.v1",
  "title": "standard-pr-incident-tracking-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-incident-tracking-output.v1"
    },
    "operation_ref": {
      "enum": [
        "session_pr_incident_record",
        "session_pr_incident_resolve"
      ]
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "no_effect",
        "confirmed",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_pr_incident_tracking_recorded": {
          "const": true
        },
        "session_pr_incident_resolution_verified": {
          "const": true
        }
      }
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "incident_id",
            "tracker_sha256",
            "tracker_metadata_sha256"
          ],
          "properties": {
            "incident_id": {
              "type": "string",
              "pattern": "^INC-TMP-[0-9]{8}-[0-9]{6}-[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
            },
            "tracker_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "tracker_metadata_sha256": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^docs/audit/incidents/INC-TMP-[0-9]{8}-[0-9]{6}-[A-Za-z0-9][A-Za-z0-9_-]{0,95}\\.md$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
