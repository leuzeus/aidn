{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-entry-input.v1",
  "x-aidn-contract-version": "standard-session-entry-input.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "session_id", "session_branch", "objective"],
  "properties": {
    "contract_version": { "const": "standard-session-entry-input.v1" },
    "session_id": { "type": "string", "pattern": "^S[0-9]{3,6}$" },
    "session_branch": { "type": "string", "minLength": 1, "maxLength": 56 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\r\n\u0000]+$" }
  }
}
