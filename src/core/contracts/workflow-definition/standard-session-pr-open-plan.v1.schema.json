{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-pr-open-plan.v1",
  "x-aidn-contract-version": "standard-session-pr-open-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "operation_id",
    "input",
    "prepared_at_ms",
    "push_source_sha256",
    "session_id",
    "provider"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-pr-open-plan.v1"
    },
    "operation_ref": {
      "const": "session_pr_open"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "push_operation_id"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-session-pr-open-input.v1"
        },
        "push_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "push_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "can_apply",
        "plan",
        "plan_sha256"
      ],
      "properties": {
        "can_apply": {
          "const": true
        },
        "plan": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "operation_id",
            "transport_context_sha256",
            "request",
            "observed"
          ],
          "properties": {
            "contract_version": {
              "const": "github-pr-open-plan.v1"
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 43,
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "transport_context_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contract_version",
                "head_branch",
                "base_branch",
                "head_oid",
                "title",
                "body"
              ],
              "properties": {
                "contract_version": {
                  "const": "github-pr-open-request.v1"
                },
                "head_branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192
                },
                "base_branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 192
                },
                "head_oid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[a-f0-9]{40}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "body": {
                  "type": "string",
                  "maxLength": 16384
                }
              }
            },
            "observed": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repository",
                "head_oid",
                "base_oid",
                "existing"
              ],
              "properties": {
                "repository": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "owner",
                    "name",
                    "node_id"
                  ],
                  "properties": {
                    "owner": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 39
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "node_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                },
                "head_oid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[a-f0-9]{40}$"
                },
                "base_oid": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40,
                  "pattern": "^[a-f0-9]{40}$"
                },
                "existing": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "contract_version",
                    "repository_id",
                    "node_id",
                    "number",
                    "head_branch",
                    "base_branch",
                    "head_oid",
                    "base_oid",
                    "state",
                    "draft",
                    "url",
                    "title_sha256",
                    "body_sha256"
                  ],
                  "properties": {
                    "contract_version": {
                      "const": "github-pr-link.v1"
                    },
                    "repository_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "node_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "head_branch": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 192
                    },
                    "base_branch": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 192
                    },
                    "head_oid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "base_oid": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "pattern": "^[a-f0-9]{40}$"
                    },
                    "state": {
                      "enum": [
                        "OPEN",
                        "CLOSED",
                        "MERGED"
                      ]
                    },
                    "draft": {
                      "type": "boolean"
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048,
                      "pattern": "^https://github[.]com/"
                    },
                    "title_sha256": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "body_sha256": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              }
            }
          }
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
