{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/workflow-project.v1",
  "x-aidn-contract-version": "workflow-project.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_revision",
    "models"
  ],
  "properties": {
    "contract_version": {
      "const": "workflow-project.v1"
    },
    "project_revision": {
      "type": "integer",
      "minimum": 1
    },
    "catalog_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 33,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model_id",
          "revision",
          "participants",
          "roles",
          "policies",
          "operation_bindings"
        ],
        "properties": {
          "model_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "policies": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "operation_bindings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "data_bindings": {
            "type": "object"
          },
          "call_interface": {
            "type": "object"
          },
          "model_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
