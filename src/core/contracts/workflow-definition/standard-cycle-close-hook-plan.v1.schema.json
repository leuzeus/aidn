{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-close-hook-plan.v1",
  "x-aidn-contract-version": "standard-cycle-close-hook-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "input",
    "operation_id",
    "prepared_at_ms",
    "context_sha256",
    "record_plan_sha256",
    "record_output_sha256",
    "scope",
    "boundary_sha256",
    "completion_preimages",
    "event_log"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-close-hook-plan.v1"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "closure_operation_id"
      ],
      "properties": {
        "closure_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "head",
        "cycle_id",
        "session_id",
        "target_state",
        "state_mode"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^C[0-9]{3,6}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^S[0-9]{3,6}$"
        },
        "target_state": {
          "enum": [
            "DONE",
            "NO_GO",
            "DROPPED"
          ]
        },
        "state_mode": {
          "enum": [
            "files",
            "dual",
            "db-only"
          ]
        }
      }
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "completion_preimages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "metadata_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metadata_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "event_log": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4194304
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
