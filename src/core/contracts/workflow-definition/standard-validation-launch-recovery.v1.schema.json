{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-validation-launch-recovery.v1",
  "x-aidn-contract-version": "standard-validation-launch-recovery.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "target_root",
    "instance_id",
    "operation_id",
    "original_configuration",
    "validation_profile"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-validation-launch-recovery.v1"
    },
    "target_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "original_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "validation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
