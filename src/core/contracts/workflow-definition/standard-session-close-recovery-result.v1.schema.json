{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-close-recovery-result.v1",
  "x-aidn-contract-version": "standard-session-close-recovery-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "instance_id",
    "record_sha256",
    "status",
    "written",
    "original_history_preserved",
    "session_closed",
    "workflow_resumed",
    "native_started"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-close-recovery-result.v1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "const": "reconciled_checkpoint_only"
    },
    "written": {
      "type": "boolean"
    },
    "original_history_preserved": {
      "const": true
    },
    "workflow_resumed": {
      "const": false
    },
    "native_started": {
      "const": false
    },
    "session_closed": {
      "const": false
    }
  }
}
