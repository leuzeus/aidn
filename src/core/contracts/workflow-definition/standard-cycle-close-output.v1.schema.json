{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-close-output.v1",
  "x-aidn-contract-version": "standard-cycle-close-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-close-output.v1"
    },
    "operation_ref": {
      "const": "cycle_close_record"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cycle_terminal_recorded": {
          "type": "boolean"
        },
        "cycle_retained": {
          "type": "boolean"
        },
        "cycle_close_completed": {
          "const": false
        }
      }
    },
    "observations": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "completed"
        },
        "effect_status": {
          "const": "confirmed"
        },
        "facts": {
          "required": [
            "cycle_terminal_recorded",
            "cycle_retained",
            "cycle_close_completed"
          ],
          "properties": {
            "cycle_terminal_recorded": {
              "const": true
            }
          }
        },
        "evidence_refs": {
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "reconciliation_required"
        },
        "effect_status": {
          "const": "unknown"
        },
        "facts": {
          "maxProperties": 0
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "blocked"
        },
        "effect_status": {
          "const": "no_effect"
        },
        "facts": {
          "maxProperties": 0
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    }
  ]
}
