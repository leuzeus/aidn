{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-handoff-resource-observation.v1",
  "x-aidn-contract-version": "standard-handoff-resource-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authority_id",
    "request_sha256",
    "observed_at_ms",
    "evidence_class",
    "domains",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-handoff-resource-observation.v1"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidence_class": {
      "enum": [
        "fixture",
        "native"
      ]
    },
    "domains": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "complete",
          "active_resources",
          "state",
          "evidence_refs"
        ],
        "properties": {
          "domain": {
            "enum": [
              "deterministic",
              "native",
              "human",
              "control",
              "process",
              "git",
              "provider"
            ]
          },
          "complete": {
            "const": true
          },
          "active_resources": {
            "const": 0
          },
          "state": {
            "const": "closed"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
