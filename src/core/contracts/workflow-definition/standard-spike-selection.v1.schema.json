{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-spike-selection.v1",
  "x-aidn-contract-version": "standard-spike-selection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cycle_id",
    "title",
    "learning_goal",
    "timebox",
    "decision_target",
    "chosen_mode",
    "branch_action"
  ],
  "properties": {
    "cycle_id": {
      "type": "string",
      "pattern": "^C[0-9]{3,6}$"
    },
    "title": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "learning_goal": {
      "type": "string",
      "minLength": 15,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "timebox": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "decision_target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\r\\n\\u0000]+$"
    },
    "chosen_mode": {
      "enum": [
        "EXPLORING",
        "COMMITTING"
      ]
    },
    "branch_action": {
      "enum": [
        "recommend",
        "create"
      ]
    }
  }
}
