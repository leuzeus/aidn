{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-rollback-plan.v1",
  "x-aidn-contract-version": "standard-drift-rollback-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "source_sha256",
    "context_sha256",
    "scope",
    "checkpoint",
    "changes"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-drift-rollback-plan.v1"
    },
    "operation_ref": {
      "const": "drift_recovery_rollback_apply"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recovery_record_operation_id"
      ],
      "properties": {
        "recovery_record_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$",
          "maxLength": 43
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "maxLength": 64
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "head",
        "index_sha256",
        "boundary_sha256"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "maxLength": 64
        },
        "index_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        },
        "boundary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "head",
        "operation_id",
        "receipt_sha256"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "head": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "maxLength": 64
        },
        "operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$",
          "maxLength": 43
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "maxLength": 64
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before",
          "after"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "before": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "oid",
              "mode",
              "sha256"
            ],
            "properties": {
              "oid": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755",
                  null
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "after": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "oid",
              "mode",
              "sha256"
            ],
            "properties": {
              "oid": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "mode": {
                "enum": [
                  "100644",
                  "100755",
                  null
                ]
              },
              "sha256": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
