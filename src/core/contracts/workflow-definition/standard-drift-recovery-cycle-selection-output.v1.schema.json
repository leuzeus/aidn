{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-recovery-cycle-selection-output.v1",
  "x-aidn-contract-version": "standard-drift-recovery-cycle-selection-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-drift-recovery-cycle-selection-output.v1"
    },
    "operation_ref": {
      "const": "drift_recovery_cycle_decision"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inbox_id",
        "source_ref",
        "source_sha256",
        "choice",
        "selected_cycle"
      ],
      "properties": {
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choice": {
          "enum": [
            "select_cycle",
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "selected_cycle": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cycle_id",
                "cycle_type",
                "title"
              ],
              "properties": {
                "cycle_id": {
                  "type": "string",
                  "pattern": "^C[0-9]{3,6}$"
                },
                "cycle_type": {
                  "enum": [
                    "feature",
                    "spike",
                    "refactor",
                    "structural",
                    "migration",
                    "security",
                    "perf",
                    "integration",
                    "compat",
                    "corrective",
                    "hotfix"
                  ]
                },
                "title": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
