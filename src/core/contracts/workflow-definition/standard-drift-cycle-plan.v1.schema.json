{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-cycle-plan.v1",
  "x-aidn-contract-version": "standard-drift-cycle-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "source_sha256",
    "context_sha256",
    "boundary_sha256",
    "inner",
    "original_references"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-drift-cycle-plan.v1"
    },
    "operation_ref": {
      "enum": [
        "drift_recovery_context_refresh",
        "drift_recovery_cycle_initialize",
        "drift_recovery_checkpoint_observe"
      ]
    },
    "input": {
      "type": "object"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inner": {
      "type": "object"
    },
    "original_references": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^audit:[A-Za-z0-9._/-]+$",
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
