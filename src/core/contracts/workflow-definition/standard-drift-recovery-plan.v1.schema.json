{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-recovery-plan.v1",
  "x-aidn-contract-version": "standard-drift-recovery-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "review_operation_id",
    "evaluation_operation_id",
    "evaluation_sha256",
    "context_sha256",
    "prepared_at_ms",
    "session_id",
    "cycle_id",
    "options",
    "changes",
    "boundary_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-drift-recovery-plan.v1"
    },
    "review_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "evaluation_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "session_id": {
      "type": "string",
      "pattern": "^S[0-9]{3,6}$"
    },
    "cycle_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^C[0-9]{3,6}$"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "choice",
          "actions"
        ],
        "properties": {
          "choice": {
            "enum": [
              "requirements_delta",
              "new_cycle",
              "rollback"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before_sha256",
          "after_sha256",
          "edit_kind",
          "text_chunks",
          "before_metadata_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          },
          "before_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "edit_kind": {
            "enum": [
              "append",
              "replace"
            ]
          },
          "text_chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "before_metadata_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "boundary_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
