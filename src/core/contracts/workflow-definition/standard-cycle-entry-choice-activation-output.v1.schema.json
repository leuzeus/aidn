              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation_ref",
        "outcome",
        "effect_status",
        "facts",
        "observations",
        "evidence_refs"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-cycle-entry-choice-activation-output.v1"
        },
