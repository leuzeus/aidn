            },
            "selected_cycle_id": {
              "type": "string",
              "pattern": "^C[0-9]{3,6}$"
            },
            "selected_cycle_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\\\\\u0000]+$"
            },
            "selected_state": {
              "enum": [
                "OPEN",
                "IMPLEMENTING",
                "VERIFYING"
              ]
            },
            "selected_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "selected_branch_head": {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            "branch_activated": {
              "const": true
            },
            "canonical_preserved": {
              "const": true
            },
            "canonical_adoption": {
              "const": false
            },
            "implementation_authorized": {
              "const": false
            },
            "git": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "branch",
                    "head",
                    "source_head",
                    "target_ref_unchanged",
                    "canonical_preserved",
                    "canonical_overlay_paths",
                    "product_tree_checked_out",
                    "implementation_authorized",
                    "effect_status"
                  ],
                  "properties": {
                    "status": {
                      "const": "confirmed"
                    },
                    "branch": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2048
                    },
                    "head": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    "source_head": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    "target_ref_unchanged": {
                      "const": true
                    },
                    "canonical_preserved": {
                      "const": true
                    },
                    "canonical_overlay_paths": {
                      "type": "array",
                      "maxItems": 10000,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2048
                      }
                    },
                    "product_tree_checked_out": {
                      "const": true
                    },
                    "implementation_authorized": {
                      "const": false
                    },
                    "effect_status": {
                      "const": "confirmed"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "status",
                    "head",
                    "effect_status"
                  ],
                  "properties": {
                    "status": {
                      "const": "no_change"
                    },
                    "head": {
                      "type": "string",
                      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                    },
                    "effect_status": {
                      "const": "no_effect"
                    }
                  }
                }
              ]
            }
          }
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "sha256"
