          ]
        },
        "facts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_entry_choice_activation_ready",
            "cycle_entry_resume_allowed"
          ],
          "properties": {
            "cycle_entry_choice_activation_ready": {
              "const": true
            },
            "cycle_entry_resume_allowed": {
              "const": false
            }
          }
        },
        "observations": {
