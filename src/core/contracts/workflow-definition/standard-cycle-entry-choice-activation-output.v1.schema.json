          ],
          "properties": {
            "checkpoint_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "record_operation_id": {
              "type": "string",
              "pattern": "^op_[a-f0-9]{40}$"
            },
            "source_sha256": {
              "type": "string",
