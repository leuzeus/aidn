{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "scope",
    "mode",
    "branch_name",
    "cycle_path",
    "session_path",
    "latest_cycle_branch",
    "templates",
    "changes"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-cycle-initialize-plan.v1"
    },
    "operation_ref": {
      "const": "cycle_initialize"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "cycle_id",
        "cycle_type",
        "title",
        "objective",
        "continuity_rule",
        "base_branch"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^S[0-9]{3,6}$"
        },
        "cycle_id": {
          "type": "string",
          "pattern": "^C[0-9]{3,6}$"
        },
        "cycle_type": {
          "enum": [
            "feature",
            "spike",
            "refactor",
            "structural",
            "migration",
            "security",
            "perf",
            "integration",
            "compat",
            "corrective",
            "hotfix"
          ]
        },
        "title": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
        },
        "objective": {
          "type": "string",
          "minLength": 15,
          "maxLength": 512,
          "pattern": "^[^\\r\\n\\u0000]+$"
        },
        "continuity_rule": {
          "enum": [
            "R1_STRICT_CHAIN",
            "R2_SESSION_BASE_WITH_IMPORT"
          ]
        },
        "base_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9/_-]{0,127}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "persistence",
        "branch",
        "head"
      ],
      "properties": {
        "project": {
          "type": "object"
        },
        "persistence": {
          "type": "object"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "head": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        }
      }
    },
    "mode": {
      "enum": [
        "COMMITTING",
        "EXPLORING"
      ]
    },
    "branch_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "cycle_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "session_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "latest_cycle_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "templates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before_sha256",
          "after",
          "after_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          },
          "before_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "after": {
            "type": "string",
            "maxLength": 1048576
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-cycle-initialize-plan.v1",
  "x-aidn-contract-version": "standard-cycle-initialize-plan.v1"
}
