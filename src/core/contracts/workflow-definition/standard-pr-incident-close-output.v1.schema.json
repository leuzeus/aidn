{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-incident-close-output.v1",
  "title": "standard-pr-incident-close-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-incident-close-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_incident_close"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_pr_incident_cleanup_completed": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "incident_id",
        "plan_sha256",
        "reason_code"
      ],
      "properties": {
        "incident_id": {
          "type": "string",
          "pattern": "^INC-TMP-[0-9]{8}-[0-9]{6}-[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason_code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
