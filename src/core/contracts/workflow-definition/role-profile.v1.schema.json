{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/role-profile.v1",
  "x-aidn-contract-version": "role-profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "revision",
    "transition_policy_ref",
    "roles",
    "capabilities",
    "role_aliases",
    "capability_aliases"
  ],
  "properties": {
    "contract_version": {
      "const": "role-profile.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "transition_policy_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}@[1-9][0-9]*$"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "host_role",
          "capabilities",
          "required_permissions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "host_role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}@[1-9][0-9]*$"
            },
            "maxItems": 64,
            "minItems": 1
          },
          "required_permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
            },
            "maxItems": 64
          }
        }
      },
      "maxItems": 64,
      "minItems": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}@[1-9][0-9]*$"
      },
      "maxItems": 64,
      "minItems": 1
    },
    "role_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    },
    "capability_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      }
    }
  }
}
