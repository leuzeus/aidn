{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-report.v1",
  "x-aidn-contract-version": "standard-drift-report.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "context_sha256", "original_objective", "current_objective", "drift_level", "objective_changed", "changes", "keep", "discard", "split_recommendation", "recommendation", "rationale", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-drift-report.v1" },
    "context_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "original_objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "current_objective": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "drift_level": { "enum": ["none", "mild", "severe"] },
    "objective_changed": { "type": "boolean" },
    "changes": { "title": "Diagnosed deviations from the stated objective or baseline; planned product edits remain separate context evidence", "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "keep": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "discard": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 2048 } },
    "split_recommendation": { "type": "object", "additionalProperties": false,
      "required": ["new_cycle", "new_branch", "change_request_required", "impact"], "properties": {
        "new_cycle": { "type": "boolean" }, "new_branch": { "type": "boolean" }, "change_request_required": { "type": "boolean" },
        "impact": { "enum": ["none", "low", "medium", "high"] }
      }
    },
    "recommendation": { "enum": ["continue", "requirements_delta", "new_cycle", "rollback", "human_arbitration"] },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "evidence_refs": { "type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {
        "ref": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    } }
  }
}
