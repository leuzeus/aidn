{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-spike-decision.v1",
  "x-aidn-contract-version": "human-spike-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "evidence_refs",
    "rationale",
    "selection"
  ],
  "properties": {
    "contract_version": {
      "const": "human-spike-decision.v1"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "convert-to-spike",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "selection": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_id",
            "title",
            "learning_goal",
            "timebox",
            "decision_target",
            "chosen_mode",
            "branch_action"
          ],
          "properties": {
            "cycle_id": {
              "type": "string",
              "pattern": "^C[0-9]{3,6}$"
            },
            "title": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            },
            "learning_goal": {
              "type": "string",
              "minLength": 15,
              "maxLength": 512,
              "pattern": "^[^\\r\\n\\u0000]+$"
            },
            "timebox": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\r\\n\\u0000]+$"
            },
            "decision_target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\r\\n\\u0000]+$"
            },
            "chosen_mode": {
              "enum": [
                "EXPLORING",
                "COMMITTING"
              ]
            },
            "branch_action": {
              "enum": [
                "recommend",
                "create"
              ]
            }
          }
        }
      ]
    }
  }
}
