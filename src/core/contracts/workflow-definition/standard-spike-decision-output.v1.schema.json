{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-spike-decision-output.v1",
  "x-aidn-contract-version": "standard-spike-decision-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-spike-decision-output.v1"
    },
    "operation_ref": {
      "const": "spike_conversion_decision"
    },
    "outcome": {
      "enum": [
        "completed",
        "rejected",
        "deferred",
        "cancelled"
      ]
    },
    "effect_status": {
      "const": "no_effect"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "spike_conversion_requested": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_sha256",
        "review_sha256",
        "source_sha256",
        "choice",
        "selection",
        "product_effects_authorized",
        "retention_authorized",
        "native_authority_renewed",
        "inbox_id",
        "source_ref"
      ],
      "properties": {
        "question_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "choice": {
          "enum": [
            "convert-to-spike",
            "refused",
            "deferred",
            "cancelled"
          ]
        },
        "selection": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cycle_id",
                "title",
                "learning_goal",
                "timebox",
                "decision_target",
                "chosen_mode",
                "branch_action"
              ],
              "properties": {
                "cycle_id": {
                  "type": "string",
                  "pattern": "^C[0-9]{3,6}$"
                },
                "title": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
                },
                "learning_goal": {
                  "type": "string",
                  "minLength": 15,
                  "maxLength": 512,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "timebox": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "decision_target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^\\r\\n\\u0000]+$"
                },
                "chosen_mode": {
                  "enum": [
                    "EXPLORING",
                    "COMMITTING"
                  ]
                },
                "branch_action": {
                  "enum": [
                    "recommend",
                    "create"
                  ]
                }
              }
            }
          ]
        },
        "product_effects_authorized": {
          "const": false
        },
        "retention_authorized": {
          "const": false
        },
        "native_authority_renewed": {
          "const": false
        },
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n\\u0000]+$"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
