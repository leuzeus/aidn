{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-validation-launch-recovery-plan.v1",
  "x-aidn-contract-version": "standard-validation-launch-recovery-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "instance_id",
    "request_sha256",
    "implementation_sha256",
    "evidence_sha256",
    "record_sha256",
    "fence_sha256",
    "already_completed",
    "validation_status",
    "workflow_resumed"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-validation-launch-recovery-plan.v1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "instance_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,95}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "already_completed": {
      "type": "boolean"
    },
    "validation_status": {
      "const": "not_started"
    },
    "workflow_resumed": {
      "const": false
    }
  }
}
