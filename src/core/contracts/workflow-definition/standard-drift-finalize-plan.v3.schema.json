{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-drift-finalize-plan.v3",
  "x-aidn-contract-version": "standard-drift-finalize-plan.v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "input",
    "prepared_at_ms",
    "context_sha256",
    "evaluation_sha256",
    "branch",
    "head",
    "report",
    "gate_constraints",
    "mode",
    "objective_alignment"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-drift-finalize-plan.v3"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_operation_id"
      ],
      "properties": {
        "evaluation_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evaluation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "head": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before_sha256",
        "after",
        "after_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^workflows/drift-reports/op_[a-f0-9]{40}\\.md$"
        },
        "before_sha256": {
          "type": "null"
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 131072
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "gate_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level1",
        "level3",
        "other_signals"
      ],
      "properties": {
        "level1": {
          "type": "object"
        },
        "level3": {
          "type": "object"
        },
        "other_signals": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        }
      }
    },
    "mode": {
      "enum": [
        "THINKING",
        "EXPLORING",
        "COMMITTING"
      ]
    },
    "objective_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "decision_operation_id",
        "evaluation_operation_id",
        "evaluation_sha256",
        "context_sha256",
        "review_sha256",
        "question_sha256",
        "source_sha256",
        "receipt_sha256",
        "inbox_id",
        "authority_id",
        "source_event_id",
        "session_objective",
        "cycle_objective",
        "rationale",
        "prepared_at_ms"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-drift-objective-disposition.v1"
        },
        "decision_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "evaluation_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "evaluation_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "question_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "receipt_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "inbox_id": {
          "type": "string",
          "pattern": "^decision_[a-f0-9]{40}$"
        },
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "cycle_objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "prepared_at_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
