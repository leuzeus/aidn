{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-review-evidence.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "repository",
    "pull_request",
    "reviews",
    "checks",
    "rollup_state",
    "observed_from",
    "observed_until",
    "requests",
    "consistency",
    "evidence_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "github-review-evidence.v2"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "owner",
        "name",
        "node_id"
      ],
      "properties": {
        "host": {
          "const": "github.com"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "number",
        "head_oid",
        "base_oid",
        "head_ref",
        "base_ref",
        "state",
        "is_draft",
        "updated_at"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "head_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "base_oid": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "head_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "base_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "state": {
          "enum": [
            "OPEN",
            "CLOSED",
            "MERGED"
          ]
        },
        "is_draft": {
          "type": "boolean"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "state",
          "submitted_at",
          "updated_at",
          "author",
          "commit_oid",
          "body_chunks",
          "body_sha256"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "enum": [
              "APPROVED",
              "CHANGES_REQUESTED",
              "COMMENTED",
              "DISMISSED",
              "PENDING"
            ]
          },
          "submitted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "login",
                  "type"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "login": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "type": {
                    "enum": [
                      "User",
                      "Bot",
                      "Organization"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "commit_oid": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "body_chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "kind",
              "name",
              "status",
              "conclusion",
              "started_at",
              "completed_at",
              "suite_id",
              "app",
              "commit_oid"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "const": "CheckRun"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "status": {
                "enum": [
                  "COMPLETED",
                  "IN_PROGRESS",
                  "PENDING",
                  "QUEUED",
                  "REQUESTED",
                  "WAITING"
                ]
              },
              "conclusion": {
                "anyOf": [
                  {
                    "enum": [
                      "ACTION_REQUIRED",
                      "CANCELLED",
                      "FAILURE",
                      "NEUTRAL",
                      "SKIPPED",
                      "STALE",
                      "STARTUP_FAILURE",
                      "SUCCESS",
                      "TIMED_OUT"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "started_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "completed_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "suite_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "app": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "node_id",
                      "slug"
                    ],
                    "properties": {
                      "node_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "slug": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commit_oid": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "kind",
              "name",
              "state",
              "created_at",
              "updated_at",
              "creator",
              "commit_oid"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "kind": {
                "const": "StatusContext"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "state": {
                "enum": [
                  "ERROR",
                  "EXPECTED",
                  "FAILURE",
                  "PENDING",
                  "SUCCESS"
                ]
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              },
              "creator": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "node_id",
                      "login",
                      "type"
                    ],
                    "properties": {
                      "node_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      },
                      "login": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "type": {
                        "enum": [
                          "User",
                          "Bot",
                          "Organization"
                        ]
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "commit_oid": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              }
            }
          }
        ]
      }
    },
    "rollup_state": {
      "anyOf": [
        {
          "enum": [
            "ERROR",
            "EXPECTED",
            "FAILURE",
            "PENDING",
            "SUCCESS"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_from": {
      "type": "string",
      "format": "date-time"
    },
    "observed_until": {
      "type": "string",
      "format": "date-time"
    },
    "requests": {
      "type": "integer",
      "minimum": 4,
      "maximum": 48
    },
    "consistency": {
      "const": "two-complete-identical-collections"
    },
    "evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
