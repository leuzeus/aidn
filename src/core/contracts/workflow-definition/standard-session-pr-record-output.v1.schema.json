{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-pr-record-output.v1",
  "x-aidn-contract-version": "standard-session-pr-record-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-pr-record-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_record"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "session_pr_lifecycle_recorded": {
          "const": true
        },
        "session_pr_checkpoint_required": {
          "const": true
        }
      }
    },
    "observations": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "const": "completed"
        },
        "effect_status": {
          "const": "confirmed"
        },
        "facts": {
          "required": [
            "session_pr_lifecycle_recorded",
            "session_pr_checkpoint_required"
          ]
        },
        "evidence_refs": {
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "reconciliation_required"
        },
        "effect_status": {
          "const": "unknown"
        },
        "facts": {
          "maxProperties": 0
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "const": "blocked"
        },
        "effect_status": {
          "const": "no_effect"
        },
        "facts": {
          "maxProperties": 0
        },
        "evidence_refs": {
          "maxItems": 0
        }
      }
    }
  ]
}
