{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-session-pr-record-plan.v1",
  "x-aidn-contract-version": "standard-session-pr-record-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "input",
    "prepared_at_ms",
    "source",
    "source_sha256",
    "git_identity_sha256",
    "state_mode",
    "changes"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-session-pr-record-plan.v1"
    },
    "operation_ref": {
      "const": "session_pr_record"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "open_operation_id"
      ],
      "properties": {
        "contract_version": {
          "const": "standard-session-pr-record-input.v1"
        },
        "open_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        }
      }
    },
    "prepared_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_operation_id",
        "session_id",
        "session_path",
        "pull_request",
        "documents",
        "material_sha256"
      ],
      "properties": {
        "open_operation_id": {
          "type": "string",
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "session_id": {
          "type": "string",
          "pattern": "^S[0-9]{3,6}$"
        },
        "session_path": {
          "type": "string",
          "pattern": "^sessions/S[0-9]{3,6}\\.md$"
        },
        "pull_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "repository_id",
            "node_id",
            "number",
            "head_branch",
            "base_branch",
            "head_oid",
            "base_oid",
            "state",
            "draft",
            "url",
            "title_sha256",
            "body_sha256"
          ],
          "properties": {
            "contract_version": {
              "const": "github-pr-link.v1"
            },
            "repository_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "head_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "base_branch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 192
            },
            "head_oid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[a-f0-9]{40}$"
            },
            "base_oid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "pattern": "^[a-f0-9]{40}$"
            },
            "state": {
              "enum": [
                "OPEN",
                "CLOSED",
                "MERGED"
              ]
            },
            "draft": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://github[.]com/"
            },
            "title_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            },
            "body_sha256": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "documents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "metadata_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "metadata_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "material_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "git_identity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state_mode": {
      "enum": [
        "files",
        "dual",
        "db-only"
      ]
    },
    "changes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "before_sha256",
          "before_metadata_sha256",
          "text_chunks",
          "after_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "before_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "before_metadata_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_chunks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "maxLength": 8192
            }
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
