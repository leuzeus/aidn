{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/handoff-process-observation.v1",
  "x-aidn-contract-version": "handoff-process-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scope_sha256",
    "scope_root_sha256",
    "observer_identity",
    "query_implementation_sha256",
    "samples",
    "stable",
    "snapshot_only",
    "complete_resource_closure",
    "permits_handoff",
    "permits_effects",
    "written",
    "coverage_basis"
  ],
  "properties": {
    "contract_version": {
      "const": "handoff-process-observation.v1"
    },
    "scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_root_sha256": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "observer_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "host",
        "pid",
        "creation"
      ],
      "properties": {
        "platform": {
          "enum": [
            "win32",
            "linux"
          ]
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "creation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "query_implementation_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "samples": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "captured_at_ms",
          "scanned_processes",
          "processes",
          "unavailable"
        ],
        "properties": {
          "captured_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scanned_processes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "processes": {
            "type": "array",
            "maxItems": 2048,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pid",
                "creation",
                "parent_pid",
                "command_line_sha256",
                "image_path_sha256",
                "scope_root_sha256",
                "scope_match"
              ],
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "creation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "parent_pid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "command_line_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "image_path_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scope_root_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "scope_match": {
                  "enum": [
                    "marker",
                    "descendant"
                  ]
                }
              }
            }
          },
          "unavailable": {
            "type": "array",
            "maxItems": 2048,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pid",
                "reason_code",
                "scope_root_sha256"
              ],
              "properties": {
                "pid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "reason_code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,95}$"
                },
                "scope_root_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "stable": {
      "type": "boolean"
    },
    "snapshot_only": {
      "const": true
    },
    "complete_resource_closure": {
      "const": false
    },
    "permits_handoff": {
      "const": false
    },
    "permits_effects": {
      "const": false
    },
    "written": {
      "const": false
    },
    "coverage_basis": {
      "const": "configured_path_markers_and_descendants"
    }
  }
}
