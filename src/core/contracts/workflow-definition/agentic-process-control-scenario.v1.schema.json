{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/agentic-process-control-scenario.v1",
  "x-aidn-contract-version": "agentic-process-control-scenario.v1",
  "title": "Bounded explicit host control scenario",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "initial_facts", "events"],
  "properties": {
    "contract_version": { "const": "agentic-process-control-scenario.v1" },
    "initial_facts": { "type": "object", "maxProperties": 128, "additionalProperties": { "type": "boolean" } },
    "events": { "type": "array", "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["after_results", "event"],
      "properties": {
        "after_results": { "type": "integer", "minimum": 0, "maximum": 120 },
        "event": { "type": "object", "required": ["event_id", "kind"], "properties": {
          "event_id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
          "kind": { "enum": ["message", "facts", "cancel"] }
        } }
      }
    } }
  }
}
