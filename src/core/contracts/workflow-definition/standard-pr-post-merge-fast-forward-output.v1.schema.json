{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-post-merge-fast-forward-output.v1",
  "x-aidn-contract-version": "standard-pr-post-merge-fast-forward-output.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_ref",
    "outcome",
    "effect_status",
    "facts",
    "observations",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-post-merge-fast-forward-output.v1"
    },
    "operation_ref": {
      "const": "session_pr_post_merge_fast_forward"
    },
    "outcome": {
      "enum": [
        "completed",
        "blocked",
        "reconciliation_required"
      ]
    },
    "effect_status": {
      "enum": [
        "confirmed",
        "no_effect",
        "unknown"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "observations": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason_code"
          ],
          "properties": {
            "reason_code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fast_forward"
          ],
          "properties": {
            "fast_forward": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_ref",
                "local_head",
                "remote_head",
                "index_sha256",
                "worktree_sha256",
                "plan_sha256",
                "decision_receipt_sha256",
                "confirmation"
              ],
              "properties": {
                "source_ref": {
                  "type": "string",
                  "pattern": "^refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
                },
                "local_head": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "remote_head": {
                  "type": "string",
                  "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
                },
                "index_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "worktree_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "plan_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "decision_receipt_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "confirmation": {
                  "enum": [
                    "executed",
                    "observed"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^git:refs/heads/[A-Za-z0-9][A-Za-z0-9._/-]{0,191}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
