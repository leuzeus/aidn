{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/agentic-process-simulation.v1",
  "title": "Internal synthetic process simulation trace",
  "x-aidn-contract-version": "agentic-process-simulation.v1",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "evidence_kind", "write_authorization", "model_sha256", "scenario_sha256", "trace"],
  "properties": {
    "contract_version": { "const": "agentic-process-simulation.v1" },
    "evidence_kind": { "const": "synthetic" },
    "write_authorization": { "const": false },
    "model_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenario_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "trace": {
      "type": "array", "minItems": 1, "maxItems": 513,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["step", "event_id", "instance_sha256", "cursor"],
        "properties": {
          "step": { "type": "integer", "minimum": 0, "maximum": 512 },
          "event_id": { "type": ["string", "null"] },
          "instance_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "cursor": { "type": "object" }
        }
      }
    }
  }
}
