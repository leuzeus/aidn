{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-retained-validation-pins.v1",
  "x-aidn-contract-version": "standard-retained-validation-pins.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "original_instance_id",
    "original_instance_sha256",
    "recovery_operation_id",
    "recovery_sha256",
    "original_configuration_sha256",
    "work_operation_id",
    "work_journal_sha256",
    "work_output_sha256",
    "native_journal_sha256",
    "dispatch_sha256",
    "validation_journal_sha256"
  ],
  "properties": {
    "original_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "original_instance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "recovery_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "recovery_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "original_configuration_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "work_operation_id": {
      "type": "string",
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "work_journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "work_output_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "native_journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dispatch_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validation_journal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
