{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/github-pr-open-request.v1",
  "x-aidn-contract-version": "github-pr-open-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "head_branch",
    "base_branch",
    "head_oid",
    "title",
    "body"
  ],
  "properties": {
    "contract_version": {
      "const": "github-pr-open-request.v1"
    },
    "head_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 192
    },
    "head_oid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "body": {
      "type": "string",
      "maxLength": 16384
    }
  }
}
