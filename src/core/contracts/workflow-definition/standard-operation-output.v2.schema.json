{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-operation-output.v2",
  "x-aidn-contract-version": "standard-operation-output.v2",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "operation_ref", "outcome", "effect_status", "facts", "observations", "evidence_refs"],
  "properties": {
    "contract_version": { "const": "standard-operation-output.v2" },
    "operation_ref": { "enum": ["mode_decision", "session_mode_apply", "session_start_finalize"] },
    "outcome": { "enum": ["completed", "blocked", "deferred", "rejected", "cancelled", "failed", "reconciliation_required"] },
    "effect_status": { "enum": ["no_effect", "confirmed", "unknown"] },
    "facts": { "type": "object", "additionalProperties": false,
      "properties": { "mode_thinking": { "type": "boolean" }, "mode_exploring": { "type": "boolean" }, "mode_committing": { "type": "boolean" },
        "session_mode_applied": { "type": "boolean" }, "session_mode_pending": { "type": "boolean" }, "session_started": { "type": "boolean" } } },
    "observations": { "type": "object", "additionalProperties": true },
    "evidence_refs": { "type": "array", "maxItems": 15, "items": { "type": "object", "additionalProperties": false,
      "required": ["ref", "sha256"], "properties": { "ref": { "type": "string", "minLength": 1, "maxLength": 256 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } } }
  }
}
