{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/human-drift-recovery-cycle-decision.v1",
  "x-aidn-contract-version": "human-drift-recovery-cycle-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_kind",
    "authority_id",
    "source_event_id",
    "subject_sha256",
    "question_sha256",
    "choice",
    "selected_cycle",
    "rationale",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "human-drift-recovery-cycle-decision.v1"
    },
    "source_kind": {
      "const": "human"
    },
    "authority_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "source_event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "subject_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "choice": {
      "enum": [
        "select_cycle",
        "refused",
        "deferred",
        "cancelled"
      ]
    },
    "selected_cycle": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cycle_id",
            "cycle_type",
            "title"
          ],
          "properties": {
            "cycle_id": {
              "type": "string",
              "pattern": "^C[0-9]{3,6}$"
            },
            "cycle_type": {
              "enum": [
                "feature",
                "spike",
                "refactor",
                "structural",
                "migration",
                "security",
                "perf",
                "integration",
                "compat",
                "corrective",
                "hotfix"
              ]
            },
            "title": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "\\S"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
