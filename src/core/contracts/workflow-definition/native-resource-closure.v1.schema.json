{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/native-resource-closure.v1",
  "x-aidn-contract-version": "native-resource-closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_sha256",
    "inventory_sha256",
    "observed_at_ms",
    "complete",
    "active_resources",
    "evidence_class",
    "resources"
  ],
  "properties": {
    "contract_version": {
      "const": "native-resource-closure.v1"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "complete": {
      "const": true
    },
    "active_resources": {
      "const": 0
    },
    "evidence_class": {
      "enum": [
        "fixture",
        "native"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 160,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource_sha256",
          "state",
          "evidence_refs"
        ],
        "properties": {
          "resource_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "state": {
            "const": "closed"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ref",
                "sha256"
              ],
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
