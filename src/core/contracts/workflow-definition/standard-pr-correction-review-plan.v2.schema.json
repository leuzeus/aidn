{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "review_operation_id",
    "checkpoint_operation_id",
    "review",
    "choices",
    "candidate_cycle"
  ],
  "properties": {
    "contract_version": {
      "const": "standard-pr-correction-review-plan.v2"
    },
    "review_operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 43,
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "checkpoint_operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 43,
      "pattern": "^op_[a-f0-9]{40}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "checkpoint_operation_id",
        "checkpoint_plan_sha256",
        "checkpoint_output_sha256",
        "reopen_operation_id",
        "triage_operation_id",
        "product_sha256",
        "provider_subject_sha256",
        "head_oid",
        "head_branch",
        "remote_head_oid",
        "base_oid",
        "state_mode",
        "postimages"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 7,
          "pattern": "^S[0-9]{3,6}$"
        },
        "checkpoint_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "checkpoint_plan_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkpoint_output_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "reopen_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "triage_operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 43,
          "pattern": "^op_[a-f0-9]{40}$"
        },
        "product_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_subject_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "head_oid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "head_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9/_-]{0,127}$"
        },
        "remote_head_oid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "base_oid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "state_mode": {
          "enum": [
            "files",
            "dual",
            "db-only"
          ]
        },
        "postimages": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "metadata_sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              },
              "metadata_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "choices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "enum": [
          "create-correction-cycle",
          "refused",
          "deferred",
          "cancelled"
        ]
      }
    },
    "candidate_cycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_id",
        "title",
        "objective"
      ],
      "properties": {
        "cycle_id": {
          "type": "string",
          "pattern": "^C[0-9]{3,6}$"
        },
        "title": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
        },
        "objective": {
          "type": "string",
          "minLength": 15,
          "maxLength": 512,
          "pattern": "^[^\\r\\n\\u0000]+$"
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/workflow-definition/standard-pr-correction-review-plan.v2",
  "x-aidn-contract-version": "standard-pr-correction-review-plan.v2"
}
