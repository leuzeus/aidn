{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/context/context-telemetry.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const":"context-telemetry.v1"},
    "window_id": {"type":"string","minLength":1,"maxLength":200},
    "model": {"type":"string","minLength":1,"maxLength":200},
    "provider": {"type":"string","minLength":1,"maxLength":200},
    "client": {"type":"string","minLength":1,"maxLength":200},
    "client_version": {"type":"string","minLength":1,"maxLength":200},
    "observed_at": {"type":"string","format":"date-time"},
    "used_tokens": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "capacity_tokens": {"type":"integer","minimum":1,"maximum":9007199254740991},
    "reserved_tokens": {"type":"integer","minimum":0,"maximum":9007199254740991},
    "parts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pinned_tokens": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "working_memory_tokens": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "retrieved_artifact_tokens": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "recent_tail_tokens": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "tool_output_tokens": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compact_count": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "new_context_count": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "retrieval_count": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "source_revision_changes": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991},
        "stale_rejection_count": {"type":["integer","null"],"minimum":0,"maximum":9007199254740991}
      }
    }
  },
  "required": ["contract_version","window_id","model","provider","client","client_version","observed_at","used_tokens","capacity_tokens","reserved_tokens"]
}
