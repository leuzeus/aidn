{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/context/agent-working-memory.v1",
  "type": "object",
  "required": ["contract_version","agent_id","objective","decisions","next_step","evidence_refs"],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const":"agent-working-memory.v1"},
    "agent_id": {"type":"string","pattern":"^[a-zA-Z0-9._-]{1,80}$"},
    "objective": {"type":"string","minLength":1,"maxLength":2000},
    "next_step": {"type":"string","minLength":1,"maxLength":2000},
    "decisions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text","evidence_refs"],
        "properties": {
          "text": {"type":"string","minLength":1,"maxLength":2000},
          "evidence_refs": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":300}}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref","bytes","sha256"],
        "properties": {
          "ref": {"type":"string","minLength":1,"maxLength":300},
          "bytes": {"type":"integer","minimum":0,"maximum":1048576},
          "sha256": {"type":"string","pattern":"^[a-f0-9]{64}$"}
        }
      }
    },
    "verified_facts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text","evidence_refs"],
        "properties": {
          "text": {"type":"string","minLength":1,"maxLength":2000},
          "evidence_refs": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":300}}
        }
      }
    },
    "dead_ends": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text","evidence_refs"],
        "properties": {
          "text": {"type":"string","minLength":1,"maxLength":2000},
          "evidence_refs": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":300}}
        }
      }
    },
    "recent_test_results": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text","evidence_refs"],
        "properties": {
          "text": {"type":"string","minLength":1,"maxLength":2000},
          "evidence_refs": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":300}}
        }
      }
    },
    "open_questions": {"type":"array","maxItems":16,"items":{"type":"string","minLength":1,"maxLength":2000}},
    "blockers": {"type":"array","maxItems":16,"items":{"type":"string","minLength":1,"maxLength":2000}},
    "todo": {"type":"array","maxItems":16,"items":{"type":"string","minLength":1,"maxLength":2000}},
    "tool_output_summaries": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text","evidence_refs"],
        "properties": {
          "text": {"type":"string","minLength":1,"maxLength":2000},
          "evidence_refs": {"type":"array","minItems":1,"maxItems":16,"items":{"type":"string","minLength":1,"maxLength":300}}
        }
      }
    },
    "execution_result_ref": {"type":"string","minLength":1,"maxLength":300}
  }
}
