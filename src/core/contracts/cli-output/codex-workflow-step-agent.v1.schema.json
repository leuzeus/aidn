{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/cli-output/codex-workflow-step-agent.v1",
  "title": "aidn codex workflow-step --view agent --json",
  "x-aidn-command": "aidn codex workflow-step --view agent --json",
  "x-aidn-contract-version": "cli-output-v1",
  "type": "object",
  "required": ["ts", "ok", "contract_version", "command", "effect_class", "view", "target_root", "skills", "summary", "observation_scope", "write_authorization", "admissions", "contexts", "artifacts", "next_action", "receipt"],
  "properties": {
    "artifact_consultation": {
      "type": "object",
      "required": [
        "contract_version",
        "profile",
        "status",
        "write_authorization",
        "fields",
        "sections",
        "sources",
        "errors",
        "omissions"
      ],
      "properties": {
        "contract_version": {
          "const": "runtime-artifact-query.v1"
        },
        "write_authorization": {
          "const": false
        },
        "status": {
          "enum": [
            "ok",
            "incomplete",
            "blocked"
          ]
        }
      },
      "additionalProperties": true
    },
    "ts": { "type": "string" },
    "ok": { "type": "boolean" },
    "contract_version": { "const": "codex-workflow-step-agent.v1" },
    "command": { "const": "aidn codex workflow-step --view agent --json" },
    "effect_class": { "enum": ["read-only", "projector", "mutating"] },
    "view": { "const": "agent" },
    "target_root": { "type": "string" },
    "mode": { "type": ["string", "null"] },
    "skills": { "type": "array", "items": { "type": "string" } },
    "workspace": { "type": "object", "additionalProperties": true },
    "summary": { "type": "object", "required": ["skill_count", "admission_count", "blocked_skill_count", "hydrate_count"], "additionalProperties": true },
    "observation_scope": { "type": "string" },
    "selection_policy": { "type": "object", "required": ["mode", "reason", "write_authorization"], "properties": {
      "mode": { "enum": ["scoped", "legacy-full-fallback", "blocked", "not-attempted"] },
      "reason": { "type": "string" }, "write_authorization": { "const": false },
      "policy_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "remediation": { "type": "string" }
    }, "additionalProperties": false },
    "context_selection": { "type": "object", "required": ["status", "scope", "errors", "omissions"], "additionalProperties": true },
    "history_view": { "const": "transitions" },
    "context_delta": { "type": "object", "required": ["contract_version", "mode", "reason", "baseline_revision", "source_revision", "unchanged_optional_refs", "removed_unit_ids", "write_authorization"], "properties": {
      "contract_version": { "const": "context-delta.v1" }, "mode": { "enum": ["full", "differential"] }, "reason": { "type": "string" },
      "baseline_revision": { "type": ["string", "null"] }, "source_revision": { "type": ["string", "null"] },
      "unchanged_optional_refs": { "type": "array" }, "removed_unit_ids": { "type": "array", "items": { "type": "string" } },
      "write_authorization": { "const": false }
    }, "additionalProperties": false },
    "bundle_budget": { "type": "object", "required": ["profile", "scope", "serialization", "target_bytes", "hard_limit_bytes", "total_bytes", "status", "minimum_required_bytes", "fits_hard_limit", "omitted_optional_ids", "expansion_required"], "properties": {
      "profile": { "const": "token-efficiency.v1" }, "scope": { "const": "complete-json" }, "serialization": { "const": "compact-utf8" },
      "target_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 }, "hard_limit_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
      "total_bytes": { "type": "integer", "minimum": 0 }, "status": { "enum": ["within-target", "blocked"] },
      "minimum_required_bytes": { "type": ["integer", "null"], "minimum": 0 }, "fits_hard_limit": { "type": "boolean" },
      "omitted_optional_ids": { "type": "array", "items": { "type": "string" } }, "expansion_required": { "type": "array" }
    }, "additionalProperties": false },
    "observation": { "type": "object", "required": ["scope", "source_revision", "write_authorization", "fence_status", "distinct_reads"], "properties": {
      "scope": { "const": "invocation-common" }, "write_authorization": { "const": false },
      "source_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "fence_status": { "const": "unchanged" },
      "distinct_reads": { "type": "integer", "minimum": 0 }
    }, "additionalProperties": false },
    "write_authorization": { "const": false },
    "admissions": {
      "type": "array",
      "items": {
        "type": "object", "required": ["skill", "ok", "admission_status", "admission_kind", "context", "blocking_reasons", "warnings", "blocking_findings", "source_of_truth"],
        "properties": {
          "skill": { "type": "string" }, "ok": { "type": "boolean" },
          "admission_status": { "type": "string" }, "admission_kind": { "type": "string" },
          "activation": { "type": "object", "required": ["active"], "properties": {
            "active": { "type": ["boolean", "null"] }, "state": { "type": "string" }
          }, "additionalProperties": true },
          "context": { "type": "object", "additionalProperties": true },
          "blocking_reasons": { "type": "array" }, "warnings": { "type": "array" }, "blocking_findings": { "type": "array" },
          "source_of_truth": { "type": "object", "additionalProperties": true }
        }, "additionalProperties": true
      }
    },
    "contexts": {
      "type": "array",
      "items": { "type": "object", "required": ["skill", "artifact_refs", "decisions", "recent_history", "repair_layer"], "properties": {
        "skill": { "type": "string" }, "source_revision": { "type": ["string", "null"] },
        "artifact_refs": { "type": "array", "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" } },
        "decisions": { "type": "object", "additionalProperties": true }, "recent_history": { "type": "array", "items": { "oneOf": [
          { "type": "object", "required": ["skill"], "properties": { "kind": { "type": "null" } }, "additionalProperties": true },
          { "type": "object", "required": ["kind", "skill", "provenance_binding", "binding_status", "first_ts", "last_ts", "observation_count", "observations", "evidence_status", "write_authorization", "requires_fresh_admission"], "properties": {
            "kind": { "const": "context-decision-transition.v1" }, "skill": { "type": "string" },
            "provenance_binding": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "binding_status": { "enum": ["files-context-bound", "unavailable"] },
            "first_ts": { "type": ["string", "null"] }, "last_ts": { "type": ["string", "null"] }, "observation_count": { "type": "integer", "minimum": 1 },
            "observations": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["id", "execution_id", "ts", "payload_digest", "raw_file"], "properties": {
              "id": { "type": ["string", "null"] }, "execution_id": { "type": ["string", "null"] }, "ts": { "type": ["string", "null"] },
              "payload_digest": { "type": ["string", "null"] }, "raw_file": { "type": ["string", "null"] }
            }, "additionalProperties": false } },
            "evidence_status": { "const": "unverified-history-references" }, "write_authorization": { "const": false }, "requires_fresh_admission": { "const": true }
          }, "additionalProperties": true }
        ] } },
        "repair_layer": { "type": ["object", "null"], "additionalProperties": true }
      }, "additionalProperties": true }
    },
    "artifacts": { "type": "array", "items": { "type": "object", "required": ["id", "source", "artifact"], "properties": {
      "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "source": { "type": "object", "additionalProperties": true },
      "artifact": { "type": "object", "additionalProperties": true }
    }, "additionalProperties": false } },
    "artifact_metadata": { "type": "array", "items": { "type": "object", "required": ["id", "source", "path", "sha256", "canonical"], "properties": {
      "id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "source": { "type": "object", "additionalProperties": true },
      "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "canonical": { "type": "object", "additionalProperties": true }
    }, "additionalProperties": false } },
    "next_action": { "type": "object", "additionalProperties": true },
    "receipt": { "type": ["object", "null"], "required": ["path", "sha256", "bytes"], "properties": {
      "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 }
    }, "additionalProperties": false },
    "daemon": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
