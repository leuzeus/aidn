{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "x-aidn-contract-version": "cli-output-v1",
  "required": [
    "contract_version",
    "command",
    "effect_class",
    "ok",
    "ts",
    "target_root",
    "action",
    "dry_run",
    "written",
    "errors",
    "warnings",
    "assets",
    "capabilities",
    "trust_instructions",
    "scope",
    "activation"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "bootstrap-diagnostics.v1"
    },
    "command": {
      "type": "string"
    },
    "effect_class": {
      "type": "string",
      "enum": [
        "read-only"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "ts": {
      "type": "string"
    },
    "target_root": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "diagnose"
      ]
    },
    "dry_run": {
      "type": "boolean",
      "const": true
    },
    "written": {
      "type": "boolean",
      "const": false
    },
    "plan_id": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "write_targets": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "version_info": {
          "type": "object",
          "required": [
            "cli_version",
            "recorded_version",
            "status",
            "receipt_version",
            "receipt_drift"
          ],
          "properties": {
            "cli_version": {
              "type": "string"
            },
            "recorded_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "unknown",
                "current",
                "mismatch"
              ]
            },
            "receipt_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "receipt_drift": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "states"
      ],
      "properties": {
        "states": {
          "type": "object",
          "required": [
            "installed",
            "detected",
            "approved",
            "connected",
            "operational",
            "degraded"
          ],
          "properties": {
            "installed": {
              "type": "string"
            },
            "detected": {
              "type": "string"
            },
            "approved": {
              "type": "string",
              "const": "unknown"
            },
            "connected": {
              "type": "string",
              "const": "not_applicable"
            },
            "operational": {
              "type": "string",
              "const": "unverified"
            },
            "degraded": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "trust_instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "codex-integration",
        "installation"
      ]
    },
    "activation": {
      "type": "object",
      "required": [
        "state",
        "active",
        "scope",
        "authority_id",
        "revision",
        "errors"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "absent",
            "unprepared",
            "legacy-active",
            "active",
            "revoked",
            "degraded"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$id": "aidn://contracts/cli-output/bootstrap-diagnostics.v1",
  "title": "AIDN Codex bootstrap-diagnostics",
  "x-aidn-command": "aidn bootstrap --diagnose --json",
  "x-aidn-commands": [
    "aidn bootstrap --diagnose --json"
  ]
}
