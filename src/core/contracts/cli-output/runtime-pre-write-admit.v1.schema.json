{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/cli-output/runtime-pre-write-admit.v1",
  "title": "aidn runtime pre-write-admit --json",
  "type": "object",
  "x-aidn-command": "aidn runtime pre-write-admit --json",
  "x-aidn-contract-version": "cli-output-v1",
  "required": [
    "ok",
    "admission_status",
    "target_root",
    "skill",
    "policy",
    "source_of_truth",
    "context",
    "checks",
    "blocking_reasons",
    "warnings",
    "prioritized_artifacts",
    "activation"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "admission_status": {
      "type": "string"
    },
    "target_root": {
      "type": "string"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": true
    },
    "shared_state_backend": {
      "type": ["object", "null"],
      "properties": {
        "runtime_backend": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "connection": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "connection_string": {
                  "type": "string",
                  "enum": [
                    "",
                    "[redacted]"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "shared_runtime_validation": {
      "type": "object",
      "additionalProperties": true
    },
    "skill": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "source_of_truth": {
      "type": "object",
      "required": [
        "state_mode",
        "runtime_state_mode",
        "concepts",
        "observed_sources",
        "issues",
        "repair_actions"
      ],
      "properties": {
        "state_mode": {
          "type": "string"
        },
        "runtime_state_mode": {
          "type": "string"
        },
        "concepts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "concept",
              "label",
              "state_mode",
              "source_of_truth",
              "projection",
              "shared_runtime"
            ],
            "properties": {
              "concept": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "state_mode": {
                "type": "string"
              },
              "source_of_truth": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "projection": {
                "type": "string"
              },
              "shared_runtime": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "observed_sources": {
          "type": "object",
          "required": [
            "current_state",
            "runtime_state",
            "session_artifact",
            "cycle_status",
            "plan_artifact"
          ],
          "properties": {
            "current_state": {
              "type": "string"
            },
            "runtime_state": {
              "type": "string"
            },
            "session_artifact": {
              "type": "string"
            },
            "cycle_status": {
              "type": "string"
            },
            "plan_artifact": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "issues": {
          "type": "array"
        },
        "repair_actions": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "additionalProperties": true
    },
    "checks": {
      "type": "object",
      "additionalProperties": true
    },
    "blocking_reasons": {
      "type": "array"
    },
    "warnings": {
      "type": "array"
    },
    "blocking_findings": {
      "type": "array"
    },
    "prioritized_artifacts": {
      "type": "array"
    },
    "activation": {
      "type": "object",
      "required": [
        "state",
        "active",
        "scope",
        "authority_id",
        "revision",
        "errors"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "absent",
            "unprepared",
            "legacy-active",
            "active",
            "revoked",
            "degraded"
          ]
        },
        "active": {
          "type": "boolean"
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "admission_kind": {
      "type": "string",
      "enum": [
        "generic",
        "specific"
      ]
    },
    "generic_admission_status": {
      "type": "string",
      "enum": [
        "admitted",
        "admitted_with_warnings",
        "blocked"
      ]
    },
    "write_decision": {
      "type": "object",
      "required": [
        "contract_version",
        "outcome",
        "reasons",
        "missing_requirements",
        "operations",
        "coverage",
        "observation",
        "next_action"
      ],
      "properties": {
        "contract_version": {
          "const": "native-write-admission.v1"
        },
        "outcome": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "requirement"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "requirement": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "operation",
              "path",
              "classification"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "add",
                  "update",
                  "delete",
                  "move",
                  "move-destination"
                ]
              },
              "path": {
                "type": "string"
              },
              "classification": {
                "enum": [
                  "note",
                  "planning",
                  "product",
                  "normative-documentation",
                  "installed-authority",
                  "workflow-state"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "coverage": {
          "type": "object",
          "required": [
            "tools",
            "format",
            "excluded",
            "semantic_validation",
            "atomic"
          ],
          "properties": {
            "tools": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "format": {
              "type": "string"
            },
            "excluded": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "semantic_validation": {
              "const": false
            },
            "atomic": {
              "const": false
            }
          },
          "additionalProperties": false
        },
        "observation": {
          "type": "object",
          "required": [
            "project_root",
            "worktree_id",
            "branch",
            "head",
            "authority_id",
            "activation_revision",
            "canonical_sha256",
            "payload_sha256",
            "paths_sha256",
            "policy_version"
          ],
          "properties": {
            "project_root": {
              "type": "string"
            },
            "branch": {
              "type": "string"
            },
            "head": {
              "type": "string"
            },
            "canonical_sha256": {
              "type": "string"
            },
            "payload_sha256": {
              "type": "string"
            },
            "paths_sha256": {
              "type": "string"
            },
            "policy_version": {
              "type": "string"
            },
            "worktree_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "authority_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "activation_revision": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "next_action": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
