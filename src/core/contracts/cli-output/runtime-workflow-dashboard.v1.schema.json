        "preview",
        "mutating",
        "executor"
      ]
    },
    "dry_run": {
      "type": "boolean"
    },
    "written": {
      "type": "boolean"
    },
    "shared_coordination_sync": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "listening": {
      "type": "boolean"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
