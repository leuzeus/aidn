    "command",
    "effect_class",
    "dry_run",
    "written",
    "shared_coordination_sync",
    "errors",
    "warnings",
    "listening",
    "url",
    "token"
  ],
  "properties": {
    "contract_version": {
      "const": "runtime-workflow-dashboard.v1"
    },
    "command": {
      "const": "aidn runtime workflow-dashboard"
    },
    "effect_class": {
      "enum": [
