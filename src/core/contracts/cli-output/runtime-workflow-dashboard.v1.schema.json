{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/cli-output/runtime-workflow-dashboard.v1",
  "title": "aidn runtime workflow-dashboard --json",
  "x-aidn-command": "aidn runtime workflow-dashboard --json",
  "x-aidn-contract-version": "cli-output-v1",
  "type": "object",
