{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/cli-output/runtime-artifact-fetch.v1",
  "title": "aidn runtime artifact-fetch --json",
  "type": "object",
  "x-aidn-command": "aidn runtime artifact-fetch --json",
  "x-aidn-contract-version": "cli-output-v1",
  "required": [
    "kind",
    "target_root",
    "selector",
    "found",
    "source_backend",
    "artifact"
  ],
  "properties": {
    "artifacts": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "required": ["path", "found", "source_revision", "artifact"],
        "properties": {"path": {"type": "string", "minLength": 1}, "found": {"type": "boolean"}, "source_revision": {"type": ["string", "null"]}, "artifact": {"type": ["object", "null"], "additionalProperties": true}},
        "additionalProperties": false
      }
    },
    "view": { "const": "agent-v1" },
    "context_excerpt": {"type": "object", "required": ["content", "heading", "source_sha256", "excerpt_sha256", "start_line", "end_line", "consultative_only"], "properties": {"content": {"type": "string"}, "heading": {"type": "string"}, "source_sha256": {"type": "string"}, "excerpt_sha256": {"type": "string"}, "start_line": {"type": "integer"}, "end_line": {"type": "integer"}, "consultative_only": {"const": true}}, "additionalProperties": false},
    "kind": { "const": "runtime-artifact-fetch" },
    "target_root": { "type": "string" },
    "selector": { "type": "object", "additionalProperties": true },
    "found": { "type": "boolean" },
    "source_backend": { "type": "string" },
    "source_file": { "type": "string" },
    "source_revision": { "type": ["string", "null"] },
    "project_context": { "type": ["object", "null"], "additionalProperties": true },
    "artifact": { "type": ["object", "null"], "additionalProperties": true }
  },
  "additionalProperties": true
}
