{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/integration-intent.v1.schema.json",
  "x-aidn-contract-version": "agent-integration-intent.v1",
  "type": "object",
  "required": [
    "contract_version",
    "integration_id",
    "run_id",
    "plan_sha256",
    "task_id",
    "attempt_id",
    "acceptance_sha256",
    "sequence",
    "repository_identity_sha256",
    "ref",
    "source_sha",
    "parent_sha",
    "created_by",
    "workspace",
    "commit_identity"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-integration-intent.v1"
    },
    "integration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "acceptance_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "repository_identity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "parent_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "created_by": {
      "type": "object",
      "required": [
        "owner_id",
        "generation",
        "lease_id"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "required": [
        "cwd",
        "detached"
      ],
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "detached": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "commit_identity": {
      "type": "object",
      "required": [
        "name",
        "email",
        "timestamp"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^\\r\\n<>\\u0000]{1,128}$"
        },
        "email": {
          "type": "string",
          "maxLength": 320,
          "pattern": "^[^\\s<>\\u0000]+@[^\\s<>\\u0000]+$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
