{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/result.v1.schema.json",
  "x-aidn-contract-version": "agent-task-result.v1",
  "type": "object",
  "required": [
    "contract_version",
    "run_id",
    "task_id",
    "attempt_id",
    "plan_sha256",
    "task_contract_sha256",
    "input_sha",
    "outcome",
    "reason_code",
    "termination_state",
    "process",
    "evidence",
    "ownership",
    "delegation_id",
    "request_sha256"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-task-result.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "cancelled",
        "timed_out",
        "indeterminate"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "termination_state": {
      "type": "string",
      "enum": [
        "not_started",
        "confirmed",
        "unknown"
      ]
    },
    "process": {
      "type": "object",
      "required": [
        "exit_code",
        "signal"
      ],
      "properties": {
        "exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "signal": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref",
          "sha256",
          "bytes"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 128
    },
    "ownership": {
      "type": "object",
      "required": [
        "owner_id",
        "generation",
        "planning_revision",
        "lease_id"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "planning_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "additionalProperties": false
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
