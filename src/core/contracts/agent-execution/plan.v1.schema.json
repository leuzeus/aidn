{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/plan.v1.schema.json",
  "x-aidn-contract-version": "agent-execution-plan.v1",
  "type": "object",
  "required": [
    "contract_version",
    "plan_id",
    "authority_backend",
    "canonical",
    "base",
    "execution",
    "limits",
    "tasks",
    "validations",
    "audit"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-execution-plan.v1"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_backend": {
      "const": "postgres"
    },
    "canonical": {
      "type": "object",
      "required": [
        "project_id",
        "workspace_id",
        "runtime_scope_id",
        "session_id",
        "cycle_id",
        "plan_ref",
        "task_selector",
        "plan_sha256",
        "planning_revision",
        "activation",
        "scope"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "runtime_scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "cycle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "task_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planning_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "activation": {
          "type": "object",
          "required": [
            "authority_id",
            "revision"
          ],
          "properties": {
            "authority_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "operations"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "add",
                    "update",
                    "delete",
                    "move",
                    "move-destination"
                  ]
                },
                "minItems": 1,
                "maxItems": 5
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1024
        }
      },
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "required": [
        "branch",
        "sha"
      ],
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "executor_id",
        "model",
        "effort",
        "sandbox",
        "engine"
      ],
      "properties": {
        "executor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "effort": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "\\S"
        },
        "sandbox": {
          "type": "string",
          "enum": [
            "workspace-write"
          ]
        },
        "native_profile": {
          "type": "object",
          "required": [
            "mode",
            "policy_sha256"
          ],
          "properties": {
            "mode": {
              "const": "preexisting"
            },
            "policy_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "engine": {
          "type": "object",
          "required": [
            "version",
            "sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "\\S"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_duration_ms"
      ],
      "properties": {
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "objective",
          "scope",
          "depends_on",
          "acceptance_criteria",
          "max_duration_ms"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "operations"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "pattern": "\\S"
                },
                "operations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "add",
                      "update",
                      "delete",
                      "move",
                      "move-destination"
                    ]
                  },
                  "minItems": 1,
                  "maxItems": 5
                }
              },
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 1024
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 0,
            "maxItems": 256
          },
          "acceptance_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "max_duration_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "validation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "minItems": 1,
            "maxItems": 256
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "validation_id",
          "argv"
        ],
        "properties": {
          "validation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "argv": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "pattern": "\\S"
            },
            "minItems": 1,
            "maxItems": 128
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "audit": {
      "type": "object",
      "required": [
        "read_only",
        "criteria"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "required": [
        "runner",
        "environment_sha256",
        "control_files",
        "audit_policy_sha256",
        "proof_authority_sha256",
        "limits"
      ],
      "properties": {
        "runner": {
          "type": "object",
          "required": [
            "id",
            "executable_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "executable_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "environment_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "control_files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "git_mode"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "git_mode": {
                "enum": [
                  "100644",
                  "100755"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "audit_policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proof_authority_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "limits": {
          "type": "object",
          "required": [
            "max_duration_ms",
            "max_output_bytes"
          ],
          "properties": {
            "max_duration_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16777216
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
