{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/acceptance.v1.schema.json",
  "x-aidn-contract-version": "agent-task-acceptance.v1",
  "type": "object",
  "required": [
    "contract_version",
    "run_id",
    "task_id",
    "attempt_id",
    "plan_sha256",
    "task_contract_sha256",
    "input_sha",
    "result_sha256",
    "candidate_sha",
    "decision",
    "validation",
    "integration",
    "cleanup"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-task-acceptance.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "result_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "tested_sha",
        "checks"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "failed",
            "unavailable"
          ]
        },
        "tested_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "validation_id",
              "status",
              "tested_sha",
              "evidence"
            ],
            "properties": {
              "validation_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "unavailable"
                ]
              },
              "tested_sha": {
                "type": "string",
                "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
              },
              "evidence": {
                "type": "object",
                "required": [
                  "ref",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "integration": {
      "type": "object",
      "required": [
        "status",
        "source_sha",
        "integrated_sha"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "pending",
            "integrated",
            "conflict",
            "rejected"
          ]
        },
        "source_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "integrated_sha": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "cleanup": {
      "type": "object",
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "verified",
            "failed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "sha256",
              "bytes"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
