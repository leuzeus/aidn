{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/run.v1.schema.json",
  "x-aidn-contract-version": "agent-execution-run.v1",
  "type": "object",
  "required": [
    "contract_version",
    "run_id",
    "plan_id",
    "plan_sha256",
    "authority_backend",
    "canonical",
    "task_ids",
    "lifecycle_status"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-execution-run.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "authority_backend": {
      "const": "postgres"
    },
    "canonical": {
      "type": "object",
      "required": [
        "project_id",
        "workspace_id",
        "runtime_scope_id",
        "session_id",
        "cycle_id",
        "plan_ref",
        "task_selector",
        "plan_sha256",
        "planning_revision",
        "activation",
        "scope"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "workspace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "runtime_scope_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|runtime:project=[A-Za-z0-9][A-Za-z0-9._:-]{0,127}:workspace=[A-Za-z0-9][A-Za-z0-9._:-]{0,127}:profile=[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$"
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "cycle_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "plan_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "\\S"
        },
        "task_selector": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planning_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "activation": {
          "type": "object",
          "required": [
            "authority_id",
            "revision"
          ],
          "properties": {
            "authority_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "additionalProperties": false
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "operations"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "operations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "add",
                    "update",
                    "delete",
                    "move",
                    "move-destination"
                  ]
                },
                "minItems": 1,
                "maxItems": 5
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 1024
        }
      },
      "additionalProperties": false
    },
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "planned",
        "running",
        "recovery_required",
        "completed",
        "failed",
        "cancelled"
      ]
    }
  },
  "additionalProperties": false
}
