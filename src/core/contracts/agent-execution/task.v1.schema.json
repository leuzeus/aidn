{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/task.v1.schema.json",
  "x-aidn-contract-version": "agent-delegated-task.v1",
  "type": "object",
  "required": [
    "contract_version",
    "run_id",
    "plan_sha256",
    "task_contract_sha256",
    "task_id",
    "objective",
    "scope",
    "depends_on",
    "acceptance_criteria",
    "max_duration_ms"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-delegated-task.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "\\S"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "operations"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "add",
                "update",
                "delete",
                "move",
                "move-destination"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096,
        "pattern": "\\S"
      },
      "minItems": 1,
      "maxItems": 128
    },
    "max_duration_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "validation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 1,
      "maxItems": 256
    }
  },
  "additionalProperties": false
}
