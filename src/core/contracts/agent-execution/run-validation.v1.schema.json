{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/run-validation.v1.schema.json",
  "x-aidn-contract-version": "agent-run-validation.v1",
  "type": "object",
  "required": [
    "contract_version",
    "validation_id",
    "run_id",
    "plan_sha256",
    "integration_sequence",
    "integrated_sha",
    "checks",
    "audit",
    "outcome"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-run-validation.v1"
    },
    "validation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "integration_sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "integrated_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "validation_id",
          "status",
          "tested_sha",
          "evidence"
        ],
        "properties": {
          "validation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unavailable"
            ],
            "type": "string"
          },
          "tested_sha": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
          },
          "evidence": {
            "type": "object",
            "required": [
              "ref",
              "sha256",
              "bytes"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "\\S"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "audit": {
      "type": "object",
      "required": [
        "read_only",
        "tested_sha",
        "checks"
      ],
      "properties": {
        "read_only": {
          "const": true
        },
        "tested_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "criterion_index",
              "status",
              "evidence"
            ],
            "properties": {
              "criterion_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "unavailable"
                ]
              },
              "evidence": {
                "type": "object",
                "required": [
                  "ref",
                  "sha256",
                  "bytes"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024,
                    "pattern": "\\S"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "unavailable"
      ]
    }
  },
  "additionalProperties": false
}
