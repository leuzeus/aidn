{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/availability.v1.schema.json",
  "x-aidn-contract-version": "agent-task-availability.v1",
  "type": "object",
  "required": [
    "contract_version",
    "executor_id",
    "status",
    "reason_code"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-task-availability.v1"
    },
    "executor_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "additionalProperties": false
}
