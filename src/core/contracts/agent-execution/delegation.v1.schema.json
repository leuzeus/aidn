{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aidn://contracts/agent-execution/delegation.v1.schema.json",
  "x-aidn-contract-version": "agent-task-delegation.v1",
  "type": "object",
  "required": [
    "contract_version",
    "delegation_id",
    "run_id",
    "task_id",
    "attempt_id",
    "plan_sha256",
    "task_contract_sha256",
    "input_sha",
    "worktree",
    "activation",
    "ownership",
    "scope"
  ],
  "properties": {
    "contract_version": {
      "const": "agent-task-delegation.v1"
    },
    "delegation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "task_contract_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "worktree": {
      "type": "object",
      "required": [
        "worktree_id",
        "cwd",
        "branch"
      ],
      "properties": {
        "worktree_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "activation": {
      "type": "object",
      "required": [
        "authority_id",
        "revision"
      ],
      "properties": {
        "authority_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "ownership": {
      "type": "object",
      "required": [
        "owner_id",
        "generation",
        "planning_revision",
        "lease_id"
      ],
      "properties": {
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "planning_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "lease_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "operations"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "\\S"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "add",
                "update",
                "delete",
                "move",
                "move-destination"
              ]
            },
            "minItems": 1,
            "maxItems": 5
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1024
    }
  },
  "additionalProperties": false
}
