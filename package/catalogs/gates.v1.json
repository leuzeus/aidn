{
  "schema_version": 2,
  "outcomes": ["PASS", "FAIL", "SKIP"],
  "obligation_values": ["required", "optional", "skip"],
  "condition_values": [
    "always",
    "git-repository",
    "git-clean-commit",
    "git-clean-worktree",
    "codex-cli-available",
    "postgres-smoke-url-available"
