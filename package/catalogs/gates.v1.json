  "documentation_policy": {
    "historical_patterns": [
      "docs/PLAN_*.md",
      "docs/BACKLOG_*.md",
      "docs/TEMPLATE_*.md",
      "docs/performance/LOT*.md"
    ],
    "derived_roots": [
      "scaffold/",
      "tests/fixtures/"
    ],
    "projection_rules": [
      {
        "target": "docs/audit/SPEC.md",
        "source": "docs/SPEC.md",
        "producer": "packs/core/manifest.yaml"
      },
      {
        "target": "docs/audit/WORKFLOW.md",
        "source": "scaffold/docs_audit/PROJECT_WORKFLOW.md",
        "producer": "src/application/install/generated-doc-render-service.mjs"
      },
      {
        "target": "docs/audit/CODEX_ONLINE.md",
        "source": "scaffold/codex/README_CodexOnline.md",
        "producer": "src/application/install/generated-doc-render-service.mjs"
      },
      {
        "target": "docs/audit/sessions/SXXX.md",
        "source": "scaffold/docs_audit/sessions/TEMPLATE_SESSION_SXXX.md",
        "producer": "packs/core/manifest.yaml"
      },
      {
        "target_prefix": "docs/audit/",
        "source_prefix": "scaffold/docs_audit/",
        "producer": "packs/core/manifest.yaml"
      }
    ],
    "marker_source": "package/catalogs/gates.v1.json"
  }
