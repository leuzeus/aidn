      "condition": "always",
      "obligation": { "dev": "required", "main": "required", "release": "required" }
    },
    {
      "id": "governance-source",
      "family": "governance",
      "script": "perf:verify-source-of-truth-policy",
      "job": "architecture-gates/governance",
      "surfaces": ["information concepts", "state modes"],
      "condition": "always",
      "obligation": { "dev": "required", "main": "required", "release": "required" }
